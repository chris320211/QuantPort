diff --git a/smoothquant/int8_export.py b/smoothquant/int8_export.py
new file mode 100644
index 0000000..2184981
--- /dev/null
+++ b/smoothquant/int8_export.py
@@ -0,0 +1,108 @@
+"""Save a smoothed, W8A8-quantized Llama-like model as real int8.
+
+quantize_model(..., keep_int8=True) leaves W8A8Linear modules that carry the
+int8 weight and its per-output-channel scale next to the fp16 weight they use in
+forward. This writes:
+
+- ``<linear>.weight``        int8  [out, in]
+- ``<linear>.weight_scale``  fp16  [out, 1]   (w_fp16 = weight * weight_scale)
+- ``<linear>.bias``          fp16  [out]      (unchanged by smoothing)
+- every other tensor (smoothed norms, embeddings, final norm) in fp16
+- no ``lm_head.weight`` when it is tied to the input embeddings
+
+plus config.json (no ``quantization_config`` key), generation_config.json, the
+tokenizer, and ``quantization_config.json`` describing the scheme. Activations
+are quantized per token, dynamically, at runtime; nothing about them is stored.
+"""
+import json
+import os
+
+import torch
+
+from smoothquant.fake_quant import W8A8Linear
+
+QUANT_CONFIG_NAME = "quantization_config.json"
+WEIGHTS_NAME = "model.safetensors"
+
+
+@torch.no_grad()
+def w8a8_int8_state_dict(model, dtype=torch.float16):
+    """Return (state_dict, quantized module names) for the int8 artifact."""
+    int8_modules = {}
+    for name, module in model.named_modules():
+        if isinstance(module, W8A8Linear):
+            if getattr(module, "weight_int8", None) is None:
+                raise ValueError(
+                    f"{name} was quantized without keep_int8=True; cannot save int8"
+                )
+            int8_modules[name] = module
+
+    state = {}
+    for key, tensor in model.state_dict().items():
+        owner = key.rpartition(".")[0]
+        if owner in int8_modules:
+            continue
+        tensor = tensor.detach()
+        if tensor.is_floating_point():
+            tensor = tensor.to(dtype)
+        state[key] = tensor.to("cpu", copy=True).contiguous()
+
+    for name, module in int8_modules.items():
+        weight = module.weight_int8.detach()
+        scale = module.weight_scale.detach()
+        out_features, in_features = module.out_features, module.in_features
+        if weight.dtype != torch.int8 or tuple(weight.shape) != (out_features, in_features):
+            raise ValueError(f"{name}: bad int8 weight {weight.dtype} {tuple(weight.shape)}")
+        if tuple(scale.shape) != (out_features, 1):
+            raise ValueError(f"{name}: bad weight_scale shape {tuple(scale.shape)}")
+        state[f"{name}.weight"] = weight.to("cpu", copy=True).contiguous()
+        state[f"{name}.weight_scale"] = scale.to("cpu", dtype=dtype, copy=True).contiguous()
+        if module.bias is not None:
+            bias = module.bias.detach().reshape(-1)
+            state[f"{name}.bias"] = bias.to("cpu", dtype=dtype, copy=True).contiguous()
+
+    if getattr(model.config, "tie_word_embeddings", False):
+        head = model.get_output_embeddings()
+        embed = model.get_input_embeddings()
+        if head is not None and head.weight is not embed.weight:
+            raise ValueError("config ties lm_head to embed_tokens but the weights differ")
+        for key in [k for k in state if k.endswith("lm_head.weight")]:
+            del state[key]
+    return state, sorted(int8_modules)
+
+
+@torch.no_grad()
+def save_w8a8_int8(model, tokenizer, output_dir, quant_config, dtype=torch.float16):
+    """Write the int8 artifact to output_dir. Returns a short summary dict."""
+    from safetensors.torch import save_file
+
+    os.makedirs(output_dir, exist_ok=True)
+    state, modules = w8a8_int8_state_dict(model, dtype=dtype)
+    if not modules:
+        raise ValueError("no W8A8Linear modules found; nothing was quantized")
+    save_file(state, os.path.join(output_dir, WEIGHTS_NAME), metadata={"format": "pt"})
+
+    config = model.config
+    if getattr(config, "quantization_config", None) is not None:
+        raise ValueError("model config already carries a quantization_config")
+    config.torch_dtype = dtype
+    config.save_pretrained(output_dir)
+    generation_config = getattr(model, "generation_config", None)
+    if generation_config is not None:
+        generation_config.save_pretrained(output_dir)
+    if tokenizer is not None:
+        tokenizer.save_pretrained(output_dir)
+
+    record = dict(quant_config)
+    record["quantized_modules"] = modules
+    record["num_quantized_linears"] = len(modules)
+    with open(os.path.join(output_dir, QUANT_CONFIG_NAME), "w") as handle:
+        json.dump(record, handle, indent=2)
+        handle.write("\n")
+    int8_bytes = sum(t.numel() for k, t in state.items() if t.dtype == torch.int8)
+    return {
+        "output_dir": output_dir,
+        "num_quantized_linears": len(modules),
+        "int8_params": int8_bytes,
+        "tensors": len(state),
+    }
