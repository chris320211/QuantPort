+@torch.no_grad()
+def quantize_weight_per_channel_absmax_int8(w, n_bits=8):
+    """Same math as quantize_weight_per_channel_absmax, but also returns the integers.
+
+    Returns (q, scales, w_dq): q is int8 [out, in], scales is [out, 1] in w.dtype, and
+    w_dq = q * scales is bit-identical to what quantize_weight_per_channel_absmax
+    computes. w itself is not modified.
+    """
+    assert n_bits == 8, "int8 storage only"
+    scales = w.abs().max(dim=-1, keepdim=True)[0]
+    q_max = 2 ** (n_bits - 1) - 1
+    scales.clamp_(min=1e-5).div_(q_max)
+    q = w.div(scales).round_().clamp_(-q_max, q_max)
+    w_dq = q.mul(scales)
+    return q.to(torch.int8), scales, w_dq
+
