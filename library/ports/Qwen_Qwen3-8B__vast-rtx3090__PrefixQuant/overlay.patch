new file mode 100644
index 0000000..054cac7
--- /dev/null
+++ b/quantize/int_linear_packed.py
@@ -0,0 +1,334 @@
+"""Real-integer PrefixQuant-O1 modules (format ``w4a4_int8_storage``).
+
+The fake-quant path (``int_linear_fake.QuantLinear`` + ``UniformAffineQuantizer``) keeps fp16
+weights on the W4 grid and fake-quantizes activations in fp16. Here the same numbers are run as
+integers:
+
+* weights: the W4 per-channel symmetric codes (``[-8, 7]``) stored as int8 ``weight`` [out, in]
+  plus the fp16 per-channel ``weight_scale`` [out, 1] (the clamped ``weight_quantizer.scale``);
+* activations: per-token dynamic symmetric 4-bit codes with the learned clipping factor
+  (``bound_factor``), produced by a Triton kernel that rounds exactly like the fp16 torch
+  quantizer (fp16 intermediate casts, round half to even, clamp to ``[-8, 7]``);
+* GEMM: the shared ``w8a8_int8`` Triton int8 x int8 -> int32 tensor-core kernel
+  (``quantize/triton_w8a8.py``, copied unchanged) with the scale epilogue
+  acc * act_scale[m] * weight_scale[n]. 4-bit codes in int8 lanes make this exact W4A4.
+
+Kernels written here:
+
+1. ``_rmsnorm_quant4_kernel``: QuantRMSNorm (fp32 RMS, fp16 weight multiply) fused with its
+   per-token A4 output quantizer; writes int8 codes + fp32 scale (for q/k/v or gate/up) and the
+   fp16 fake-quant value (what the fake path returns, for shapes and any non-packed consumer).
+2. ``_act_quant4_kernel`` / ``_act_quant4_looped_kernel``: per-token A4 quantizer of the o_proj
+   and down_proj inputs (the latter after the R4 online Hadamard, fast_hadamard_transform).
+3. ``_group_fake_quant4_kernel``: group-wise (head_dim) dynamic KV4 fake quantization of K (after
+   R3 + RoPE, unclipped) and V (v_proj output, clipped), fp16 in/out, same rounding as torch.
+
+Triton value arguments are Python floats/ints; clipping factors are read through pointers so no
+host sync is needed.
+"""
+import math
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+import triton
+import triton.language as tl
+
+from quantize import triton_w8a8
+
+FORMAT = 'w4a4_int8_storage'
+QMIN = -8
+QMAX = 7
+_SCALE_MIN = 1e-4
+_SCALE_MAX = 1e4
+
+
+@triton.jit
+def _round_half_even(v):
+    r = tl.floor(v + 0.5)
+    tie = (r - v) == 0.5
+    odd = (r - 2.0 * tl.floor(r * 0.5)) != 0.0
+    return tl.where(tie & odd, r - 1.0, r)
+
+
+@triton.jit
+def _scale_from_amax(amax, bf_ptr, HAS_CLIP: tl.constexpr):
+    """fp16 torch order: amax * bound_factor -> 2 * . -> / 15 -> clamp(1e-4, 1e4), each cast to fp16."""
+    if HAS_CLIP:
+        bf = tl.load(bf_ptr).to(tl.float32)
+        amax = (amax * bf).to(tl.float16).to(tl.float32)
+    rng = (2.0 * amax).to(tl.float16).to(tl.float32)
+    scale = tl.math.div_rn(rng, 15.0).to(tl.float16).to(tl.float32)
+    scale = tl.minimum(tl.maximum(scale, 1e-4), 1e4).to(tl.float16).to(tl.float32)
+    return scale
+
+
+@triton.jit
+def _codes(x, scale):
+    v = tl.math.div_rn(x, scale).to(tl.float16).to(tl.float32)
+    r = _round_half_even(v)
+    return tl.minimum(tl.maximum(r, -8.0), 7.0)
+
+
+@triton.jit
+def _rmsnorm_quant4_kernel(
+    x_ptr, w_ptr, bf_ptr, dq_ptr, q_ptr, s_ptr,
+    K, eps, stride_x, stride_dq, stride_q,
+    HAS_CLIP: tl.constexpr, BLOCK_K: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    offs = tl.arange(0, BLOCK_K)
+    mask = offs < K
+    x = tl.load(x_ptr + row * stride_x + offs, mask=mask, other=0.0).to(tl.float32)
+    var = tl.sum(x * x, axis=0) / K
+    xn = (x * tl.math.rsqrt(var + eps)).to(tl.float16).to(tl.float32)
+    w = tl.load(w_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    xn = (xn * w).to(tl.float16).to(tl.float32)
+    amax = tl.max(tl.where(mask, tl.abs(xn), 0.0), axis=0)
+    scale = _scale_from_amax(amax, bf_ptr, HAS_CLIP)
+    r = _codes(xn, scale)
+    tl.store(q_ptr + row * stride_q + offs, r.to(tl.int8), mask=mask)
+    tl.store(dq_ptr + row * stride_dq + offs, (r * scale).to(dq_ptr.dtype.element_ty), mask=mask)
+    tl.store(s_ptr + row, scale)
+
+
+@triton.jit
+def _act_quant4_kernel(
+    x_ptr, bf_ptr, q_ptr, s_ptr, K, stride_x, stride_q,
+    HAS_CLIP: tl.constexpr, BLOCK_K: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    offs = tl.arange(0, BLOCK_K)
+    mask = offs < K
+    x = tl.load(x_ptr + row * stride_x + offs, mask=mask, other=0.0).to(tl.float32)
+    amax = tl.max(tl.abs(x), axis=0)
+    scale = _scale_from_amax(amax, bf_ptr, HAS_CLIP)
+    r = _codes(x, scale)
+    tl.store(q_ptr + row * stride_q + offs, r.to(tl.int8), mask=mask)
+    tl.store(s_ptr + row, scale)
+
+
+@triton.jit
+def _act_quant4_looped_kernel(
+    x_ptr, bf_ptr, q_ptr, s_ptr, K, stride_x, stride_q,
+    HAS_CLIP: tl.constexpr, BLOCK_K: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    x_row = x_ptr + row * stride_x
+    q_row = q_ptr + row * stride_q
+    offs = tl.arange(0, BLOCK_K)
+    run_max = tl.zeros((BLOCK_K,), dtype=tl.float32)
+    for k0 in range(0, K, BLOCK_K):
+        mask = (k0 + offs) < K
+        x = tl.load(x_row + k0 + offs, mask=mask, other=0.0).to(tl.float32)
+        run_max = tl.maximum(run_max, tl.abs(x))
+    scale = _scale_from_amax(tl.max(run_max, axis=0), bf_ptr, HAS_CLIP)
+    for k0 in range(0, K, BLOCK_K):
+        mask = (k0 + offs) < K
+        x = tl.load(x_row + k0 + offs, mask=mask, other=0.0).to(tl.float32)
+        tl.store(q_row + k0 + offs, _codes(x, scale).to(tl.int8), mask=mask)
+    tl.store(s_ptr + row, scale)
+
+
+@triton.jit
+def _group_fake_quant4_kernel(
+    x_ptr, bf_ptr, y_ptr, n_rows,
+    HAS_CLIP: tl.constexpr, GROUP: tl.constexpr, ROWS: tl.constexpr,
+):
+    pid = tl.program_id(0).to(tl.int64)
+    rows = pid * ROWS + tl.arange(0, ROWS)
+    cols = tl.arange(0, GROUP)
+    rmask = rows < n_rows
+    ptrs = rows[:, None] * GROUP + cols[None, :]
+    x = tl.load(x_ptr + ptrs, mask=rmask[:, None], other=0.0).to(tl.float32)
+    amax = tl.max(tl.abs(x), axis=1)
+    scale = _scale_from_amax(amax, bf_ptr, HAS_CLIP)
+    r = _codes(x, scale[:, None])
+    tl.store(y_ptr + ptrs, (r * scale[:, None]).to(y_ptr.dtype.element_ty), mask=rmask[:, None])
+
+
+def _rows(x):
+    x2d = x.reshape(-1, x.shape[-1])
+    if x2d.stride(-1) != 1:
+        x2d = x2d.contiguous()
+    return x2d
+
+
+def rmsnorm_quant4(x, weight, eps, bound_factor=None):
+    """Fused QuantRMSNorm + A4 per-token output quantizer -> (fp16 fake-quant, int8 codes, fp32 scale)."""
+    x2d = _rows(x)
+    m, k = x2d.shape
+    dq = torch.empty((m, k), dtype=x.dtype, device=x.device)
+    q = torch.empty((m, k), dtype=torch.int8, device=x.device)
+    s = torch.empty((m,), dtype=torch.float32, device=x.device)
+    if m:
+        block = triton.next_power_of_2(int(k))
+        _rmsnorm_quant4_kernel[(int(m),)](
+            x2d, weight, bound_factor if bound_factor is not None else weight, dq, q, s,
+            int(k), float(eps), int(x2d.stride(0)), int(dq.stride(0)), int(q.stride(0)),
+            HAS_CLIP=bound_factor is not None, BLOCK_K=block, num_warps=8 if block >= 4096 else 4)
+    return dq.view(x.shape), q, s
+
+
+def act_quant4(x2d, bound_factor=None):
+    """Per-token dynamic symmetric A4 (learned clip) -> (int8 codes [M, K], fp32 scale [M])."""
+    m, k = x2d.shape
+    q = torch.empty((m, k), dtype=torch.int8, device=x2d.device)
+    s = torch.empty((m,), dtype=torch.float32, device=x2d.device)
+    if m:
+        block = triton.next_power_of_2(int(k))
+        args = (x2d, bound_factor if bound_factor is not None else x2d, q, s, int(k), int(x2d.stride(0)), int(q.stride(0)))
+        if block <= 4096:
+            _act_quant4_kernel[(int(m),)](*args, HAS_CLIP=bound_factor is not None, BLOCK_K=block, num_warps=8)
+        else:
+            _act_quant4_looped_kernel[(int(m),)](*args, HAS_CLIP=bound_factor is not None, BLOCK_K=4096, num_warps=8)
+    return q, s
+
+
+def group_fake_quant4(x, group_size, bound_factor=None, out=None):
+    """Group-wise (last dim, ``group_size`` = head_dim) dynamic symmetric 4-bit fake quantization."""
+    if x.shape[-1] % group_size:
+        raise ValueError(f'last dim {x.shape[-1]} is not a multiple of group size {group_size}')
+    src = x if x.is_contiguous() else x.contiguous()
+    y = out if out is not None else torch.empty_like(src)
+    n_rows = src.numel() // group_size
+    if n_rows:
+        rows = 16
+        _group_fake_quant4_kernel[(triton.cdiv(n_rows, rows),)](
+            src, bound_factor if bound_factor is not None else src, y, int(n_rows),
+            HAS_CLIP=bound_factor is not None, GROUP=int(group_size), ROWS=rows, num_warps=4)
+    return y
+
+
+class ClipFactor(nn.Module):
+    """Holds a dynamic quantizer's learned clipping factor under the fake path's state-dict name."""
+
+    def __init__(self, clipping=True):
+        super().__init__()
+        if clipping:
+            self.bound_factor = nn.Parameter(torch.ones(1, dtype=torch.float16), requires_grad=False)
+        else:
+            self.bound_factor = None
+
+
+class PackedQuantRMSNorm(nn.Module):
+    """QuantRMSNorm with a dynamic A4 output quantizer, run as one Triton kernel.
+
+    Returns the fp16 fake-quant tensor (identical to the fake path's output) and attaches
+    ``_pq_codes = (int8 codes [M, K], fp32 scale [M])`` to it; the PackedQuantLinear consumers
+    (q/k/v_proj, gate/up_proj) read those codes instead of re-quantizing.
+    """
+
+    def __init__(self, hidden_size, eps, clipping=True, dtype=torch.float16):
+        super().__init__()
+        self.register_buffer('weight', torch.empty(hidden_size, dtype=dtype))
+        self.variance_epsilon = eps
+        self.output_quantizer = ClipFactor(clipping)
+
+    def forward(self, x):
+        dq, q, s = rmsnorm_quant4(x, self.weight, self.variance_epsilon, self.output_quantizer.bound_factor)
+        dq._pq_codes = (q, s)
+        return dq
+
+
+class PackedQuantLinear(nn.Module):
+    """W4 (int8 storage) x A4 linear with the shared int8 Triton GEMM.
+
+    ``input_source``: 'norm' (codes come attached from PackedQuantRMSNorm), or 'dynamic'
+    (own per-token A4 input quantizer with a learned clip, optionally after the R4 online
+    Hadamard). ``output_group``: group size of the dynamic V-cache fake quantizer applied to the
+    output (v_proj), or 0.
+    """
+
+    def __init__(self, in_features, out_features, bias=False, input_source='norm', online_had=False,
+                 output_group=0, clipping=True, dtype=torch.float16):
+        super().__init__()
+        self.in_features = in_features
+        self.out_features = out_features
+        self.register_buffer('weight', torch.empty((out_features, in_features), dtype=torch.int8))
+        self.register_buffer('weight_scale', torch.empty((out_features, 1), dtype=dtype))
+        if bias:
+            self.register_buffer('bias', torch.empty(out_features, dtype=dtype))
+        else:
+            self.bias = None
+        self.input_source = input_source
+        self.input_quantizer = ClipFactor(clipping) if input_source == 'dynamic' else None
+        self.online_had = online_had
+        self.had_K = None
+        self.had_n = 1
+        self.had_scale = 1.0
+        self.output_group = output_group
+        self.output_quantizer = ClipFactor(clipping) if output_group else None
+        self.gemm_config = None  # (BLOCK_M, BLOCK_N, BLOCK_K, GROUP_M, warps, stages) or None = default
+        self._warned = False
+
+    def setup_online_had(self, device, dtype):
+        """R4 online Hadamard of the fake path (hadamard_utils.matmul_hadU_cuda), had_K kept on device."""
+        import utils.hadamard_utils as hadamard_utils
+        had_K, K = hadamard_utils.get_hadK(self.in_features)
+        self.had_n = int(K)
+        self.had_K = None if had_K is None else had_K.to(device=device, dtype=dtype)
+        # matmul_hadU_cuda passes 1/sqrt(n) as a float32 tensor; use that exact value
+        self.had_scale = float(1.0 / torch.tensor(self.in_features).sqrt())
+
+    def _hadamard(self, x):
+        import fast_hadamard_transform
+        n = x.shape[-1]
+        if self.had_n == 1:
+            return fast_hadamard_transform.hadamard_transform(x.contiguous(), self.had_scale)
+        inp = x.reshape(-1, self.had_n, n // self.had_n)
+        inp = fast_hadamard_transform.hadamard_transform(inp.contiguous(), self.had_scale)
+        inp = self.had_K @ inp
+        return inp.reshape(x.shape)
+
+    def dequantized_weight(self, dtype):
+        return (self.weight.to(dtype) * self.weight_scale.to(dtype))
+
+    def forward(self, x):
+        lead = x.shape[:-1]
+        if self.input_source == 'dynamic':
+            if self.online_had:
+                x = self._hadamard(x)
+            q, s = act_quant4(_rows(x), self.input_quantizer.bound_factor)
+        else:
+            codes = getattr(x, '_pq_codes', None)
+            if codes is None:
+                # not fed by a PackedQuantRMSNorm (x is already the fake-quant value): dense fallback
+                if not self._warned:
+                    print(f'[prefixquant packed] {self.__class__.__name__}: input without int codes, dense fallback')
+                    self._warned = True
+                out = F.linear(x, self.dequantized_weight(x.dtype), self.bias)
+                return self._output_quant(out)
+            q, s = codes
+        out = triton_w8a8.w8a8_matmul(q, s, self.weight, self.weight_scale, self.bias, x.dtype, self.gemm_config)
+        return self._output_quant(out.view(*lead, self.out_features))
+
+    def _output_quant(self, out):
+        if self.output_group:
+            out = group_fake_quant4(out, self.output_group, self.output_quantizer.bound_factor)
+        return out
+
+    def extra_repr(self):
+        return (f'in={self.in_features}, out={self.out_features}, input={self.input_source}, '
+                f'online_had={self.online_had}, out_group={self.output_group}, format={FORMAT}')
+
+
+def pack_weight(weight, scale, check=True):
+    """Fake-quant fp16 weight on the W4 grid + its quantizer scale -> (int8 codes, fp16 scale).
+
+    The fake path computed weight = fp16(round(w / s).clamp(-8, 7) * s) with s = scale.clamp(1e-4, 1e4)
+    in fp16, so the codes are recovered exactly; ``check`` asserts that fp16(codes * s) reproduces
+    every stored weight bit for bit (i.e. the artifact really is on the grid).
+    """
+    s16 = scale.to(torch.float16).reshape(-1, 1)
+    # quantizer.clamp_ste in fp16: (clamp(s) - s) + s, which is not exactly clamp(s) when s is
+    # out of range (block-AP can drive a scale below 1e-4, even negative)
+    s16 = (s16.clamp(_SCALE_MIN, _SCALE_MAX) - s16) + s16
+    w32 = weight.float()
+    codes = torch.round(w32 / s16.float()).clamp_(QMIN, QMAX)
+    if check:
+        back = (codes.to(torch.float16) * s16)
+        bad = (back != weight.to(torch.float16)).sum().item()
+        if bad:
+            raise RuntimeError(f'weight is not on the W4 grid of its scale: {bad} of {weight.numel()} values differ')
+    return codes.to(torch.int8), s16.contiguous()
