+def _is_trainable_weight(model, n):
+    '''
+    The repo trains the fp weights of the quantized linears; norm gammas are frozen (QuantRMSNorm
+    keeps them as buffers). A norm that is not wrapped (Qwen3's per-head q_norm/k_norm) still has
+    a `weight` Parameter, so the name test alone would train it: restrict to linear weights.
+    '''
+    if n.find('weight') == -1 or n.find('weight_quantizer') > -1:
+        return False
+    owner = model.get_submodule(n.rsplit('.', 1)[0]) if '.' in n else model
+    return isinstance(owner, nn.Linear)
