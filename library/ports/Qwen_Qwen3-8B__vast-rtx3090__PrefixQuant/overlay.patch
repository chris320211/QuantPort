+                    and not getattr(past_key_values, '_quant_agent_prefix_len', 0)
+                    and past_key_values.get_seq_length() == 0):
+                model_utils.fill_prefix_cache(past_key_values, self._quant_agent_prefix_kv, ref.shape[0])
+                past_key_values._quant_agent_prefix_len = prefix_len
