+def choose_start_token(tokenizer):
+    '''
+    The token that opens a document, appended last to the prefix (paper Sec. 4.2, "[BOS]").
+    Chosen from the tokenizer, not the model name: bos_token when defined; otherwise the
+    document-separator/pad token (Qwen: <|endoftext|>, which is also Qwen2-base's eos); eos_token
+    only as a last resort (for chat tokenizers it is an end-of-turn marker such as <|im_end|>).
+    '''
+    for attr in ('bos_token', 'pad_token', 'eos_token'):
+        token = getattr(tokenizer, attr, None)
+        if token:
+            ids = tokenizer.encode(token, add_special_tokens=False)
+            if ids:
+                return attr, token, ids
+    raise ValueError('tokenizer defines none of bos_token/pad_token/eos_token')
+
+
+@torch.no_grad()
+def outlier_ratio(dataloader, model, prefixed_tokens=None, num_samples=8, down_proj_name='down_proj'):
+    '''
+    Max over samples and layers of top-1/median of the token-wise max |x| at the down_proj input,
+    over the real tokens only (prefix positions excluded). Used to check that the prefix absorbs
+    the outlier tokens.
+    '''
+    captured = {}
+    hooks = []
+    for name, module in model.named_modules():
+        if name.endswith(down_proj_name) and isinstance(module, torch.nn.Module) and hasattr(module, 'weight'):
+            hooks.append(module.register_forward_hook(get_activation_hook_2(name, captured, True)))
+    skip = len(prefixed_tokens) if prefixed_tokens else 0
+    worst = 0.0
+    device = next(model.parameters()).device
+    try:
+        for i in range(min(num_samples, len(dataloader))):
+            data = dataloader[i][0]
+            if skip:
+                data = torch.cat([torch.tensor([prefixed_tokens]), data], dim=1)
+            model(data.to(device))
+            for act in captured.values():
+                token_max = act[:, skip:].abs().amax(dim=-1).flatten().float()
+                worst = max(worst, (token_max.max() / token_max.median().clamp(min=1e-12)).item())
+    finally:
+        for h in hooks:
+            h.remove()
+    return worst
 
 
