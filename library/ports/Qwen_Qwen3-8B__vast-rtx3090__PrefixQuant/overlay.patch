+                            past_key_values=past_key_values, inputs_embeds=inputs_embeds, labels=labels,
+                            use_cache=use_cache, cache_position=cache_position, **kwargs)
+
+    model.__class__ = type('Prefixed' + base.__name__, (base,),
+                           {'forward': forward, '_quant_agent_prefix_class': True, '__module__': base.__module__})
+    return model
