+"""Packed (real-integer) PrefixQuant-O1 artifacts: convert a fake-quant artifact, load, run.
+
+Format ``w4a4_int8_storage`` (see quantize/int_linear_packed.py): every decoder projection
+stores its W4 codes as int8 ``weight`` [out, in] + fp16 ``weight_scale`` [out, 1]; the residual
+norms, embeddings, lm_head, q_norm/k_norm stay fp16; the learned clipping factors keep their
+fake-path names (``*.input_quantizer.bound_factor``, ``*.output_quantizer.bound_factor``);
+the fp16 prefix KV and ``prefixequant_config.json`` are copied unchanged.
+
+``convert_artifact`` reads the verified fake-quant artifact shard by shard (fp16 weights on the
+grid of ``weight_quantizer.scale``) and writes the packed one, checking that every code
+reproduces its fp16 weight bit for bit. ``load_packed_model`` builds the model on the meta device,
+swaps in the packed modules, allocates on the GPU and copies the saved tensors in (no fp16
+copy of the projections is ever built), then attaches the R3 Hadamard + K4 wrapper, the prefix
+KV injection and the prefix-aware SDPA attention.
+
+Attention (``prefixquant_sdpa``): with the P-token prefix in the cache a prefill has
+q_len = L, kv_len = P + L, so ``is_causal`` (top-left aligned) cannot be used directly. When the
+caller has no padding the query is front-padded with P zero rows, which makes the causal mask
+square (row P + i sees keys 0..P + i, exactly the bottom-right mask), SDPA runs its flash kernel
+with ``is_causal=True`` and the P padded rows are dropped. Decode (q_len = 1) attends to the whole
+cache without a mask. Anything else (padding, long offsets) uses the 4D mask transformers built.
+"""
+import json
+import math
+import os
+import shutil
+import types
+
+import torch
+import torch.nn.functional as F
+from transformers.cache_utils import Cache, DynamicCache
+
+import utils.model_utils as model_utils
+from quantize import int_linear_packed as packed
+from quantize.int_linear_packed import FORMAT, PackedQuantLinear, PackedQuantRMSNorm
+
+QUANT_CONFIG_FILE = 'prefixequant_config.json'
+ATTN_IMPL = 'prefixquant_sdpa'
+PREFIX_PAD_LIMIT = 64
+ATTN_PROJ = ('q_proj', 'k_proj', 'v_proj', 'o_proj')
+MLP_PROJ = ('gate_proj', 'up_proj', 'down_proj')
+SHARD_BYTES = 4 * 1024 ** 3
+COPY_FILES = ('config.json', 'generation_config.json', 'tokenizer.json', 'tokenizer_config.json',
+              'special_tokens_map.json', 'added_tokens.json', 'vocab.json', 'merges.txt',
+              'tokenizer.model', 'chat_template.jinja', model_utils.PREFIX_KV_FILE)
+
+
+# ----------------------------------------------------------------------------- config
+
+def read_config(model_path):
+    with open(os.path.join(model_path, QUANT_CONFIG_FILE)) as handle:
+        return json.load(handle)
+
+
+def is_packed(model_path):
+    path = os.path.join(model_path, QUANT_CONFIG_FILE)
+    if not os.path.exists(path):
+        return False
+    return read_config(model_path).get('packed_format') == FORMAT
+
+
+def check_supported(qcfg):
+    """The packed path implements PrefixQuant-O1 exactly; refuse anything else."""
+    want = {'wbits': 4, 'w_group_size': -1, 'w_asym': False, 'input_bits': 4, 'input_group_size': -1,
+            'input_asym': False, 'input_mode': 'dynamic', 'kv_asym': False, 'k_pre_rope': False}
+    bad = {k: qcfg.get(k) for k, v in want.items() if qcfg.get(k) != v}
+    for key in ('k_bits', 'v_bits'):
+        if qcfg.get(key, 16) < 16 and (qcfg.get('kv_mode') != 'dynamic' or qcfg.get(key) != 4):
+            bad[key] = (qcfg.get(key), qcfg.get('kv_mode'))
+    if bad:
+        raise ValueError(f'packed {FORMAT} supports PrefixQuant-O1 (W4 per-channel sym, dynamic per-token A4 sym, '
+                         f'dynamic KV4 sym); artifact differs: {bad}')
+
+
+def kernel_quant_config(qcfg):
+    """Keys `kernels.py match` reads from quantization_config.json."""
+    return {
+        'format': FORMAT,
+        'quant_method': 'prefixquant',
+        'w_bits': 4,
+        'a_bits': 4,
+        'kv_bits': 4 if qcfg.get('k_bits', 16) < 16 else 16,
+        'weight_quant': 'per_channel',
+        'act_quant': 'per_token',
+        'w_sym': True,
+        'a_sym': True,
+        'online_transforms': True,
+        'weight_storage': 'int8 codes in [-8, 7] + fp16 per-channel scale',
+        'kernels': 'Triton int8 GEMM (shared w8a8_int8) + fused RMSNorm/A4 quant + group KV4 fake quant; '
+                   'prefix-aware flash SDPA',
+    }
+
+
+# ----------------------------------------------------------------------------- conversion
+
+def _weight_files(model_path):
+    index = os.path.join(model_path, 'model.safetensors.index.json')
+    if os.path.exists(index):
+        with open(index) as handle:
+            return sorted(set(json.load(handle)['weight_map'].values()))
+    return ['model.safetensors']
+
+
+def _layer_proj(key):
+    """'model.layers.3.self_attn.q_proj.weight' -> 'model.layers.3.self_attn.q_proj' for decoder projections."""
+    if not key.endswith('.weight') or '.layers.' not in key:
+        return None
+    prefix = key[:-len('.weight')]
+    if prefix.split('.')[-1] in ATTN_PROJ + MLP_PROJ:
+        return prefix
+    return None
+
+
+@torch.no_grad()
+def convert_artifact(src, dst, device='cuda', log=print):
+    """Fake-quant PrefixQuant-O1 artifact at ``src`` -> packed ``w4a4_int8_storage`` artifact at ``dst``."""
+    from safetensors import safe_open
+    from safetensors.torch import save_file
+
+    if os.path.abspath(src) == os.path.abspath(dst):
+        raise ValueError('convert into a new directory, not in place')
+    qcfg = read_config(src)
+    check_supported(qcfg)
+    os.makedirs(dst, exist_ok=True)
+
+    handles = {name: safe_open(os.path.join(src, name), framework='pt') for name in _weight_files(src)}
+    where = {key: name for name, h in handles.items() for key in h.keys()}
+    out_keys = {}
+    projections = 0
+    for key in sorted(where):
+        if key.endswith('.weight_quantizer.scale'):
+            continue  # folded into <proj>.weight_scale
+        tensor = handles[where[key]].get_tensor(key)
+        proj = _layer_proj(key)
+        if proj is not None:
+            scale_key = proj + '.weight_quantizer.scale'
+            if scale_key not in where:
+                raise RuntimeError(f'{key}: no {scale_key} in the artifact')
+            scale = handles[where[scale_key]].get_tensor(scale_key)
+            codes, wscale = packed.pack_weight(tensor.to(device), scale.to(device), check=True)
+            out_keys[proj + '.weight'] = codes.cpu()
+            out_keys[proj + '.weight_scale'] = wscale.cpu()
+            projections += 1
+            continue
+        if key.endswith('bound_factor') and tensor.dim() == 0:
+            tensor = tensor.reshape(1)  # legacy 0-dim factor
+        out_keys[key] = tensor.contiguous()
+    if projections == 0:
+        raise RuntimeError('no decoder projections found to pack')
+
+    # shard and write
+    shards, current, size = [], {}, 0
+    for key in sorted(out_keys):
+        nbytes = out_keys[key].numel() * out_keys[key].element_size()
+        if current and size + nbytes > SHARD_BYTES:
+            shards.append(current)
+            current, size = {}, 0
+        current[key] = out_keys[key]
+        size += nbytes
+    shards.append(current)
+    weight_map, total = {}, 0
+    for i, shard in enumerate(shards):
+        name = f'model-{i + 1:05d}-of-{len(shards):05d}.safetensors'
+        save_file(shard, os.path.join(dst, name), metadata={'format': 'pt', 'packed_format': FORMAT})
+        for key, tensor in shard.items():
+            weight_map[key] = name
+            total += tensor.numel() * tensor.element_size()
+    with open(os.path.join(dst, 'model.safetensors.index.json'), 'w') as handle:
+        json.dump({'metadata': {'total_size': total, 'packed_format': FORMAT}, 'weight_map': weight_map}, handle, indent=2)
+
+    for name in COPY_FILES:
+        path = os.path.join(src, name)
+        if os.path.exists(path):
+            shutil.copy2(path, os.path.join(dst, name))
+    qcfg = dict(qcfg)
+    qcfg['packed_format'] = FORMAT
+    qcfg['real_quant'] = True
+    qcfg['packed_from'] = os.path.abspath(src)
+    with open(os.path.join(dst, QUANT_CONFIG_FILE), 'w') as handle:
+        json.dump(qcfg, handle, indent=4)
+    log(f'packed {projections} projections into {len(shards)} shard(s), {total / 1e9:.2f} GB of tensors')
+    return {'projections': projections, 'shards': len(shards), 'tensor_bytes': total}
+
+
+# ----------------------------------------------------------------------------- attention
+
+def prefix_sdpa_attention(module, query, key, value, attention_mask, dropout=0.0, scaling=None,
+                          is_causal=None, **kwargs):
+    q_len, kv_len = query.shape[2], key.shape[2]
+    offset = kv_len - q_len
+    if kwargs.get('pq_dense_causal', False) and 0 <= offset <= PREFIX_PAD_LIMIT and dropout == 0.0:
+        gqa = query.shape[1] != key.shape[1]
+        if q_len == 1:
+            out = F.scaled_dot_product_attention(query, key, value, scale=scaling, enable_gqa=gqa)
+        else:
+            if offset:
+                pad = query.new_zeros(query.shape[0], query.shape[1], offset, query.shape[3])
+                query = torch.cat([pad, query], dim=2)
+            out = F.scaled_dot_product_attention(query, key, value, is_causal=True, scale=scaling, enable_gqa=gqa)
+            if offset:
+                out = out[:, :, offset:]
+        return out.transpose(1, 2).contiguous(), None
+    from transformers.integrations.sdpa_attention import sdpa_attention_forward
+    return sdpa_attention_forward(module, query, key, value, attention_mask, dropout=dropout, scaling=scaling,
+                                  is_causal=is_causal, **kwargs)
+
+
+def register_attention():
+    from transformers.modeling_utils import ALL_ATTENTION_FUNCTIONS
+    try:
+        ALL_ATTENTION_FUNCTIONS[ATTN_IMPL] = prefix_sdpa_attention
+    except TypeError:
+        ALL_ATTENTION_FUNCTIONS.register(ATTN_IMPL, prefix_sdpa_attention)
+
+
+# ----------------------------------------------------------------------------- R3 + K4 wrapper
+
+def _qk_wrapper_class():
+    from fast_hadamard_transform import hadamard_transform
+    from utils.rotation_utils import QKRotationWrapper
+
+    class PackedQKRotationWrapper(QKRotationWrapper):
+        """QKRotationWrapper with the K4 group quantizer as one Triton kernel (same numbers)."""
+
+        def forward(self, *args, **kwargs):
+            q, k = self.func(*args, **kwargs)
+            dtype = q.dtype
+            if self.online_had:
+                q = hadamard_transform(q.float(), scale=1 / math.sqrt(q.shape[-1])).to(dtype)
+                k = hadamard_transform(k.float(), scale=1 / math.sqrt(k.shape[-1])).to(dtype)
+            if self.use_k_quant and self.k_bits < 16:
+                # groups of head_dim along the last axis == the fake path's transpose/flatten grouping
+                k = packed.group_fake_quant4(k, self.k_group, self.k_bound_factor)
+            return q, k
+
+    return PackedQKRotationWrapper
+
+
+def add_qk_wrapper(layer, rope_function_name, config, qcfg):
+    import functools
+    import quantize.monkeypatch as monkeypatch
+    cls = _qk_wrapper_class()
+    attn = layer.self_attn
+    wrapper = monkeypatch.add_wrapper_after_function_call_in_method(
+        attn, 'forward', rope_function_name,
+        functools.partial(cls, config=config, online_had=bool(qcfg.get('qk_online_had'))))
+    setattr(attn, f'{rope_function_name}_qk_rotation_wrapper', wrapper)
+    k_bits = qcfg.get('k_bits', 16)
+    wrapper.use_k_quant = k_bits < 16
+    wrapper.k_bits = k_bits
+    head_dim = model_utils.get_head_dim(config)
+    group = qcfg.get('kv_group_size', head_dim)
+    if group not in (-1, head_dim):
+        raise ValueError(f'K quant group {group} must be head_dim {head_dim}')
+    wrapper.k_group = head_dim
+    wrapper.k_bound_factor = None  # init_k_quantizer builds the K quantizer without clipping
+    return wrapper
+
+
+# ----------------------------------------------------------------------------- model build + load
+
+def _build_skeleton(model_path, dtype, qcfg):
+    from transformers import AutoConfig, AutoModelForCausalLM
+
+    config = AutoConfig.from_pretrained(model_path, local_files_only=True)
+    clipping = bool(qcfg.get('activation_clipping'))
+    v_group = qcfg.get('kv_group_size', 128) if qcfg.get('v_bits', 16) < 16 else 0
+    eps = model_utils.get_rms_norm_eps(config)
+    with torch.device('meta'):
+        model = AutoModelForCausalLM.from_config(config, torch_dtype=dtype, attn_implementation='sdpa')
+        for layer in model_utils.get_layers(model):
+            attn, mlp = layer.self_attn, layer.mlp
+            for name in ATTN_PROJ:
+                lin = getattr(attn, name)
+                setattr(attn, name, PackedQuantLinear(
+                    lin.in_features, lin.out_features, bias=lin.bias is not None,
+                    input_source='dynamic' if name == 'o_proj' else 'norm',
+                    output_group=v_group if name == 'v_proj' else 0, clipping=clipping, dtype=dtype))
+            for name in MLP_PROJ:
+                lin = getattr(mlp, name)
+                setattr(mlp, name, PackedQuantLinear(
+                    lin.in_features, lin.out_features, bias=lin.bias is not None,
+                    input_source='dynamic' if name == 'down_proj' else 'norm',
+                    online_had=bool(qcfg.get('down_online_had')) and name == 'down_proj',
+                    clipping=clipping, dtype=dtype))
+            for name in ('input_layernorm', 'post_attention_layernorm'):
+                norm = getattr(layer, name)
+                setattr(layer, name, PackedQuantRMSNorm(norm.weight.shape[0], eps, clipping=clipping, dtype=dtype))
+    return model
+
+
+@torch.no_grad()
+def _load_tensors(model, model_path, device):
+    from safetensors import safe_open
+
+    state = dict(model.named_parameters())
+    state.update(dict(model.named_buffers()))
+    persistent = set(model.state_dict().keys())
+    expected = {k for k in state if k in persistent}
+    seen = set()
+    for name in _weight_files(model_path):
+        with safe_open(os.path.join(model_path, name), framework='pt') as handle:
+            for key in handle.keys():
+                if key not in expected:
+                    raise RuntimeError(f'unexpected tensor in packed artifact: {key}')
+                tensor = handle.get_tensor(key)
+                target = state[key]
+                if tensor.shape != target.shape:
+                    if tensor.numel() == target.numel():
+                        tensor = tensor.reshape(target.shape)
+                    else:
+                        raise RuntimeError(f'{key}: saved {tuple(tensor.shape)} vs built {tuple(target.shape)}')
+                if tensor.dtype != target.dtype and target.dtype != torch.int8:
+                    tensor = tensor.to(target.dtype)
+                elif target.dtype == torch.int8 and tensor.dtype != torch.int8:
+                    raise RuntimeError(f'{key}: expected int8 codes, got {tensor.dtype}')
+                target.copy_(tensor)
+                seen.add(key)
+    missing = sorted(expected - seen)
+    if missing:
+        raise RuntimeError(f'packed artifact is missing {len(missing)} tensors: {missing[:8]}')
+
+
+def load_packed_model(model_path, device='cuda', dtype=torch.float16):
+    if not str(device).startswith('cuda'):
+        raise RuntimeError(f'{FORMAT} artifacts need CUDA (Triton int8 GEMM); got device={device}')
+    if dtype != torch.float16:
+        dtype = torch.float16  # the kernels reproduce the fp16 fake-quant numerics
+    qcfg = read_config(model_path)
+    check_supported(qcfg)
+    model = _build_skeleton(model_path, dtype, qcfg)
+    model.to_empty(device=device)
+    _load_tensors(model, model_path, device)
+    for param in model.parameters():
+        param.requires_grad = False
+    model_utils.restore_rope_fp32(model)  # inv_freq is a non-persistent buffer: recompute on device
+    for module in model.modules():
+        if isinstance(module, PackedQuantLinear) and module.online_had:
+            module.setup_online_had(device, dtype)
+    rope_function_name = model_utils.get_rope_function_name(model)
+    for layer in model_utils.get_layers(model):
+        add_qk_wrapper(layer, rope_function_name, model.config, qcfg)
+    try:
+        from transformers import GenerationConfig
+        model.generation_config = GenerationConfig.from_pretrained(model_path, local_files_only=True)
+    except Exception:
+        pass
+    register_attention()
+    model.config._attn_implementation = ATTN_IMPL
+
+    prefix = None
+    if qcfg.get('set_prefixed_tokens'):
