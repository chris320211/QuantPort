@@ -0,0 +1,192 @@
+"""Inference runtime for a saved PrefixQuant artifact (transformers >= 4.51).
+
+What ``main.save_quant_model`` writes: fake-quantized fp16 weights (already on the W4 grid after
+``block_ap.quant_inplace``) and every quantizer scale (``save_pretrained``), the fp16 prefix
+(K, V) of every layer (``prefixed_key_values.safetensors``) and ``prefixequant_config.json``.
+
+``attach_quantization`` rebuilds on a stock model loaded from that directory exactly what the
+quantization run had at the end of ``block_ap`` (the eval.py recipe, with the residual norms
+selected by name so that Qwen3's q_norm/k_norm stay plain): QuantLinear (an nn.Linear
+subclass) for every decoder projection, the A4 output quantizers of the two residual norms, the
+o_proj/down_proj input quantizers, the v_proj output (V cache) quantizer, the R4 online
+Hadamard on the down_proj input, and the R3 Hadamard + K quantizer in the RoPE wrapper (after
+q_norm/k_norm and RoPE). The quantizer mode comes from ``prefixequant_config.json``:
+static (O2) quantizers load their saved ``scale``; dynamic (O1, per-token activations and
+group-wise KV) quantizers compute the range online and, with ``activation_clipping``, load the
+learned per-layer ``bound_factor`` (``upbound_factor``/``lowbound_factor`` when asymmetric).
+The repo builds the K quantizer without clipping, so a dynamic K quantizer has no saved state.
+Weight quantization is not re-applied per forward (the stored weights are already quantized);
+activation and KV quantizers run online.
+
+``install_prefix`` makes the model behave like the calibrated one: every forward that starts a
+sequence gets a fresh, batch-expanded copy of the fp16 prefix KV, real tokens sit at positions
+>= P and the attention mask covers the P prefix columns. Logits, loss and ``generate`` output
+only cover the caller's tokens.
+"""
+import json
+import os
+import types
+
+import torch
+from transformers.cache_utils import Cache, DynamicCache
+
+import utils.model_utils as model_utils
+import utils.rotation_utils as rotation_utils
+from quantize.quantizer import UniformAffineQuantizer
+from utils.quant_utils import (
+    init_input_quantizer,
+    init_k_quantizer,
+    init_v_quantizer,
+    init_weight_quantizer,
+    register_online_had,
+    set_quant_state,
+    wrap_to_quant_model,
+)
+
+QUANT_CONFIG_FILE = 'prefixequant_config.json'
+QUANTIZER_KEY = '_quantizer.'
+_CONFIG_DEFAULTS = {
+    'wbits': 16, 'w_group_size': -1, 'w_asym': False,
+    'input_bits': 16, 'input_group_size': -1, 'input_asym': False, 'input_mode': 'static',
+    'k_bits': 16, 'v_bits': 16, 'kv_group_size': 128, 'kv_asym': False, 'kv_mode': 'static',
+    'k_pre_rope': False, 'down_online_had': False, 'qk_online_had': False,
+    'activation_clipping': False, 'set_prefixed_tokens': False,
+}
+
+
+def read_quant_config(model_path):
+    with open(os.path.join(model_path, QUANT_CONFIG_FILE)) as handle:
+        config = json.load(handle)
+    return types.SimpleNamespace(**{**_CONFIG_DEFAULTS, **config})
+
+
+def _weight_files(model_path):
+    index = os.path.join(model_path, 'model.safetensors.index.json')
+    if os.path.exists(index):
+        with open(index) as handle:
+            return sorted(set(json.load(handle)['weight_map'].values()))
+    return ['model.safetensors']
+
+
+def read_quantizer_state(model_path):
+    """Every saved quantizer tensor (scales), read straight from the safetensors shards."""
+    from safetensors import safe_open
+    state = {}
+    for name in _weight_files(model_path):
+        with safe_open(os.path.join(model_path, name), framework='pt') as handle:
+            for key in handle.keys():
+                if QUANTIZER_KEY in key:
+                    state[key] = handle.get_tensor(key)
+    return state
+
+
+def attach_quantization(model, model_path, device=None, dtype=torch.float16):
+    qcfg = read_quant_config(model_path)
+    if qcfg.k_pre_rope:
+        raise ValueError('k_pre_rope artifacts are not supported (K must be quantized after RoPE)')
+    for param in model.parameters():
+        param.requires_grad = False
+    wrap_to_quant_model(model)
+    if qcfg.down_online_had:
+        register_online_had(model)
+    rope_function_name = model_utils.get_rope_function_name(model)
+    for layer in model_utils.get_layers(model):
+        rotation_utils.add_qk_rotation_wrapper_after_function_call_in_forward(
+            layer.self_attn, rope_function_name, config=model.config, online_had=qcfg.qk_online_had)
+    if qcfg.wbits < 16:
+        init_weight_quantizer(qcfg, model, minmax_init=False)
+    if qcfg.input_bits < 16:
+        init_input_quantizer(qcfg, model, minmax_init=False)
+    if qcfg.v_bits < 16:
+        init_v_quantizer(qcfg, model, minmax_init=False)
+    if qcfg.k_bits < 16:
+        init_k_quantizer(qcfg, model, minmax_init=False)
+
+    saved = read_quantizer_state(model_path)
+    current = model.state_dict()
+    expected = {key for key in current if QUANTIZER_KEY in key}
+    missing = sorted(expected - saved.keys())
+    unexpected = sorted(saved.keys() - expected)
+    if missing or unexpected:
+        raise RuntimeError(f'quantizer set mismatch: missing={missing[:8]} ({len(missing)}), '
+                           f'unexpected={unexpected[:8]} ({len(unexpected)})')
+    for key, tensor in saved.items():
+        want = current[key].shape
+        if tensor.shape != want:
+            # artifacts written before the shape-preserving mse_init stored clipping factors
+            # as 0-dim scalars; the value is the same, only the shape differs
+            if tensor.numel() != current[key].numel():
+                raise RuntimeError(f'quantizer tensor {key}: saved {tuple(tensor.shape)} vs built {tuple(want)}')
+            saved[key] = tensor.reshape(want)
+    model.load_state_dict(saved, strict=False)
+    if device is None:
+        device = model.get_input_embeddings().weight.device
+    for module in model.modules():
+        if isinstance(module, UniformAffineQuantizer):
+            module.to(device=device, dtype=dtype)
+    # end state of block_ap: weights already quantized in place, activations/K/V quantized online
+    set_quant_state(model, weight_quant=False, act_quant=True)
+    model_utils.restore_rope_fp32(model)
+
+    prefix = None
+    if qcfg.set_prefixed_tokens:
+        prefix = model_utils.load_prefixed_key_values(model_path, device=device, dtype=dtype)
+        if prefix is None:
+            raise RuntimeError('artifact has set_prefixed_tokens but no prefixed_key_values file')
+        prefix = model_utils.mv_kv_cache(prefix, model=model)
+    install_prefix(model, prefix)
+    clip_keys = [key for key in expected if key.endswith('bound_factor')]
+    if qcfg.activation_clipping and (qcfg.input_mode == 'dynamic' or qcfg.kv_mode == 'dynamic') and not clip_keys:
+        raise RuntimeError('activation_clipping artifact has no saved bound_factor tensors')
+    model.quant_agent_runtime = {
+        'quantizers': len(expected),
+        'input_mode': qcfg.input_mode,
+        'kv_mode': qcfg.kv_mode,
+        'activation_clipping': bool(qcfg.activation_clipping),
+        'clipping_factors': len(clip_keys),
+        'prefixed_tokens': getattr(qcfg, 'prefixed_tokens', None),
+        'prefix_length': 0 if prefix is None else int(prefix[0][0].shape[-2]),
+        'down_online_had': bool(qcfg.down_online_had),
+        'qk_online_had': bool(qcfg.qk_online_had),
+    }
+    return model
+
+
+def install_prefix(model, prefixed_key_values):
+    """Swap in a subclass whose forward injects a fresh prefix cache at the start of a sequence."""
+    base = model.__class__
+    if getattr(base, '_quant_agent_prefix_class', False):
+        base = base.__mro__[1]
+    model._quant_agent_prefix_kv = prefixed_key_values
+    model._quant_agent_prefix_len = 0 if prefixed_key_values is None else int(prefixed_key_values[0][0].shape[-2])
+
+    def forward(self, input_ids=None, attention_mask=None, position_ids=None, past_key_values=None,
+                inputs_embeds=None, labels=None, use_cache=None, cache_position=None, **kwargs):
+        prefix_len = self._quant_agent_prefix_len
+        ref = input_ids if input_ids is not None else inputs_embeds
+        if prefix_len and ref is not None:
+            if past_key_values is None:
+                past_key_values = DynamicCache()
+            if (isinstance(past_key_values, Cache)
+                    and not getattr(past_key_values, '_quant_agent_prefix_len', 0)
+                    and past_key_values.get_seq_length() == 0):
+                # new sequence (plain forward, PPL window, first generate step): fresh prefix copy
+                model_utils.fill_prefix_cache(past_key_values, self._quant_agent_prefix_kv, ref.shape[0])
+                past_key_values._quant_agent_prefix_len = prefix_len
+            shift = getattr(past_key_values, '_quant_agent_prefix_len', 0)
+            if shift:
+                # the caller counts positions without the prefix (generate does too)
+                if attention_mask is not None and attention_mask.dim() == 2:
+                    attention_mask = torch.cat(
+                        [attention_mask.new_ones((attention_mask.shape[0], shift)), attention_mask], dim=-1)
+                if cache_position is not None:
+                    cache_position = cache_position + shift
+                if position_ids is not None:
+                    position_ids = position_ids + shift
+        return base.forward(self, input_ids=input_ids, attention_mask=attention_mask, position_ids=position_ids,
+                            past_key_values=past_key_values, inputs_embeds=inputs_embeds, labels=labels,
+                            use_cache=use_cache, cache_position=cache_position, **kwargs)
+
+    model.__class__ = type('Prefixed' + base.__name__, (base,),
+                           {'forward': forward, '_quant_agent_prefix_class': True, '__module__': base.__module__})
+    return model
