diff --git a/quant_agent_inference_adapter.py b/quant_agent_inference_adapter.py
new file mode 100644
index 0000000..84293da
--- /dev/null
+++ b/quant_agent_inference_adapter.py
@@ -0,0 +1,61 @@
+"""Reload a packed int4 FlatQuant Qwen2 artifact (W4A4KV4) from its saved directory.
+
+The artifact (flat_utils.save_quantized_weights_with_safetensors via
+flatquant/qwen2_packed.py) holds uint8-packed int4 weights for the 7 decoder
+projections, fp16 per-channel scales, fp16 norms (diag scales fused), q/k/v biases
+(v bias already in P_v space), the online transform matrices and the learned
+activation / KV clip logits. lm_head is tied to embed_tokens and not stored.
+
+deploy.transformers.modeling_qwen2.FlatQuantQwen2ForCausalLM rebuilds the model with
+deploy.nn.Linear4bit (CUTLASS int4 GEMM; the int32 accumulator is scaled in fp32
+torch because deploy.sym_dequant truncates it to a multiple of 10), online Kronecker transforms (Triton
+kron_matmul where a load-time probe agrees with torch, torch otherwise), P_h after
+RoPE, a torch P_o^T head transform, and an int4 KV cache. The loader casts kernel
+scales to float16, restores the eval-only runtime flags (_eval_mode, use_diag=False),
+re-ties lm_head, and never re-fuses the packed weights.
+"""
+import os
+import sys
+
+QUANT_AGENT_ADAPTER_API = 1
+
+
+def _ensure_method_repo_on_path():
+    here = os.path.dirname(os.path.abspath(__file__))
+    for root in (os.environ.get("QUANT_AGENT_METHOD_REPO"), here):
+        if root and os.path.isdir(os.path.join(root, "deploy")) and root not in sys.path:
+            sys.path.insert(0, root)
+
+
+def load_model_and_tokenizer(model_path, model_id=None, dtype="float16", device="cuda", trust_remote_code=False):
+    _ensure_method_repo_on_path()
+    import torch
+    from transformers import AutoTokenizer
+
+    from deploy.transformers.modeling_qwen2 import (
+        FlatQuantQwen2ForCausalLM,
+        cast_linear4bit_kernel_dtypes,
+        restore_packed_eval_runtime,
+    )
+
+    if device != "cuda" or not torch.cuda.is_available():
+        raise RuntimeError("the packed int4 FlatQuant model needs CUDA (deploy._CUDA int4 GEMM)")
+    if dtype not in ("float16", "auto"):
+        print(f"[flatquant adapter] dtype={dtype!r} requested; the int4 kernels run in float16", file=sys.stderr)
+
+    model = FlatQuantQwen2ForCausalLM.from_pretrained(model_path, device=device)
+    # from_pretrained already does both; repeating them is idempotent and keeps the
+    # contract visible: fp16 kernel scales after load, eval-only flags restored.
+    cast_linear4bit_kernel_dtypes(model)
+    report = restore_packed_eval_runtime(
+        model,
+        kron_backend=os.environ.get("FLATQUANT_KRON_BACKEND", "auto"),
+        dequant_backend=os.environ.get("FLATQUANT_DEQUANT_BACKEND", "torch"),
+    )
+    print(f"[flatquant adapter] runtime: {report}", file=sys.stderr)
+
+    tokenizer = AutoTokenizer.from_pretrained(model_path, local_files_only=True)
+    if tokenizer.pad_token_id is None and tokenizer.eos_token_id is not None:
+        tokenizer.pad_token = tokenizer.eos_token
+    model.eval()
+    return model, tokenizer
