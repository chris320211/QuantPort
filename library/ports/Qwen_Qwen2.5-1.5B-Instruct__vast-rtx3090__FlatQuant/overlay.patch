diff --git a/flatquant/qwen2_packed.py b/flatquant/qwen2_packed.py
new file mode 100644
index 0000000..6f4e585
--- /dev/null
+++ b/flatquant/qwen2_packed.py
@@ -0,0 +1,202 @@
+"""Qwen2 glue for the packed int4 export (``--quantized_save``) and its deploy reload.
+
+The calibration itself is the repo's own Qwen2 path (``model_utils.get_qwen2`` ->
+``qwen_utils.apply_flatquant_to_qwen`` -> ``train_utils.cali_flat_quant`` ->
+``flat_utils.reparameterize_model`` -> ``gptq_utils.rtn_fwrd``). This module only
+holds the Qwen2.5 script settings, the RTN/export filters, and the packed export
+that ``deploy/transformers/modeling_qwen2.py`` reloads.
+"""
+import argparse
+import json
+import os
+import re
+
+import torch
+
+PACKED_FORMAT = "flatquant_qwen2_packed_int4"
+
+# The 7 decoder projections, as named inside a decoder layer by find_qlayers.
+PROJECTION_RE = re.compile(r"^(self_attn\.(q|k|v|o)_proj|mlp\.(gate|up|down)_proj)\.linear$")
+
+# Tensors the packed runtime never reads: folded inverses / diag scales / LWC logits,
+# P_v (folded into v_proj and o_proj), and the stale InvSingleTransMatrix.linear
+# weights that --direct_inv keeps next to the frozen matrices.
+EXPORT_EXCLUDE_RE = re.compile(
+    r"(trans\.linear(_left|_right)?\.weight$"
+    r"|trans\.matrix_(left|right)_inv$"
+    r"|o_trans\.matrix_inv_t$"
+    r"|vcache_trans\."
+    r"|trans\.diag_scale$"
+    r"|clip_factor_w_(max|min)$)"
+)
+
+
+def qwen25_w4a4kv4_args(exp_dir, nsamples=128, epochs=15, cali_bsz=4, model_name="", seed=0):
+    """Flags of scripts/qwen-2.5-instruct/*/w4a4kv4.sh (D8), as parser_gen would set them."""
+    return argparse.Namespace(
+        model=model_name, seed=seed, hf_token=None,
+        a_bits=4, a_groupsize=-1, a_asym=False,
+        w_bits=4, w_groupsize=-1, w_asym=False, gptq=False, gptq_mse=False, percdamp=.01, act_order=False,
+        epochs=epochs, cali_dataset="wikitext2", nsamples=nsamples, cali_bsz=cali_bsz, flat_lr=5e-3,
+        cali_trans=True, add_diag=True, lwc=True, lac=True,
+        resume=False, save_matrix=True, reload_matrix=False, matrix_path=None,
+        diag_init="sq_style", diag_alpha=0.3, warmup=False, deactive_amp=True, direct_inv=True,
+        separate_vtrans=False,
+        q_bits=16, q_asym=False, q_groupsize=-1,
+        k_bits=4, k_asym=True, k_groupsize=128,
+        v_bits=4, v_asym=True, v_groupsize=128,
+        output_dir=exp_dir, exp_name="exp", exp_dir=exp_dir, model_name=os.path.basename(str(model_name)),
+        quantize=True, quantized_save=True, distribute_model=False, lm_eval=False,
+    )
+
+
+def epochs_for_steps(target_steps, nsamples, cali_bsz=4):
+    """Epochs giving at least ``target_steps`` optimizer steps per layer (cali_flat_quant does
+    ``nsamples // cali_bsz`` steps per epoch). Smoke only: on Qwen2.5 the k_proj bias (absmax
+    ~316 in layer 0) dominates the per-token KV4 key range, and the learned P_h / K clip need
+    ~200+ optimizer steps to tame it (spec D10). Steps matter, not data volume."""
+    per_epoch = max(1, nsamples // max(1, min(cali_bsz, nsamples)))
+    return max(1, -(-int(target_steps) // per_epoch))
+
+
+def is_packed_projection(name):
+    return PROJECTION_RE.match(name) is not None
+
+
+def export_exclude(name):
+    return EXPORT_EXCLUDE_RE.search(name) is not None
+
+
+def check_quantizers(quantizers, num_layers):
+    names = sorted(quantizers)
+    bad = [n for n in names if "trans" in n]
+    if bad:
+        raise RuntimeError(f"transform linears were RTN-quantized: {bad[:5]}")
+    if len(names) != 7 * num_layers:
+        raise RuntimeError(f"expected {7 * num_layers} quantized projections, got {len(names)}")
+
+
+def quant_config_for(args, model, extra=None):
+    cfg = model.config
+    head_dim = cfg.hidden_size // cfg.num_attention_heads
+    from flatquant.function_utils import get_decompose_dim
+    out = {
+        "quant_method": "flatquant",
+        "method_name": "FlatQuant",
+        "deploy_format": PACKED_FORMAT,
+        "format": "packed_int4",
+        "w_bits": args.w_bits,
+        "a_bits": args.a_bits,
+        "k_bits": args.k_bits,
+        "v_bits": args.v_bits,
+        "q_bits": args.q_bits,
+        "weight_quant": "per_channel",
+        "w_sym": not args.w_asym,
+        "weight_rounding": "rtn",
+        "weight_dtype": "uint8 (two signed int4 per byte, pack_i4)",
+        "weight_scale_dtype": "float16",
+        "act_quant": "per_token",
+        "a_sym": not args.a_asym,
+        "act_dynamic": True,
+        "learned_act_clipping": bool(args.lac),
+        "learned_weight_clipping": bool(args.lwc),
+        "kv_quant": "per_token_per_head",
+        "kv_asym": bool(args.k_asym and args.v_asym),
+        "kv_group_size": head_dim,
+        "kv_learned_clipping": bool(args.lac),
+        "online_transforms": True,
+        "trans": "matmul",
+        "fuseLN": False,
+        "online_trans": ["qkv_proj", "qk", "o_proj", "up_gate_proj", "down_proj"],
+        "kronecker_factors": {
+            "hidden": list(get_decompose_dim(cfg.hidden_size)),
+            "intermediate": list(get_decompose_dim(cfg.intermediate_size)),
+        },
+        "o_proj_head_transform": [cfg.num_attention_heads, cfg.num_attention_heads],
+        "folded_offline": [
+            "diag scales -> input_layernorm / post_attention_layernorm / up_proj rows",
+            "(P1 kron P2)^-T and LWC -> q/k/v/gate/up/down weights",
+            "P_v -> v_proj weight and bias",
+            "(P_o kron P_v)^-T -> o_proj weight",
+        ],
+        "kept_float16": ["embed_tokens (lm_head tied, not stored)", "norms", "q/k/v biases", "transform matrices"],
+        "calibration": {
+            "dataset": "wikitext2 train (local parquet)",
+            "nsamples": args.nsamples,
+            "seqlen": None,
+            "epochs": args.epochs,
+            "cali_bsz": args.cali_bsz,
+            "flat_lr": args.flat_lr,
+            "flags": ["--lwc", "--lac", "--cali_trans", "--add_diag", "--deactive_amp", "--direct_inv"],
+            "seed": args.seed,
+        },
+        "publish_exclude": ["flat_parameters.pth", "flat_matrices.pth"],
+        "inference_adapter": "quant_agent_inference_adapter.py",
+        "reload_class": "deploy.transformers.modeling_qwen2.FlatQuantQwen2ForCausalLM",
+    }
+    if extra:
+        out.update(extra)
+    return out
+
+
+def export_qwen2_packed(args, model, quantizers, tokenizer, out_dir, quant_config):
+    """--quantized_save for Qwen2: packed int4 safetensors + HF config/tokenizer files."""
+    from flatquant import flat_utils
+    from safetensors import safe_open
+
+    os.makedirs(out_dir, exist_ok=True)
+    check_quantizers(quantizers, model.config.num_hidden_layers)
+    flat_utils.save_quantized_weights_with_safetensors(
+        args, model, quantizers, sym=not args.w_asym,
+        save_dir=out_dir, exclude=export_exclude, scale_dtype=torch.float16,
+        config_extra=quant_config,
+    )
+    config = model.config.__class__.from_dict(model.config.to_dict())
+    config.torch_dtype = torch.float16
+    config.architectures = ["Qwen2ForCausalLM"]
+    if hasattr(config, "quantization_config"):
+        delattr(config, "quantization_config")
+    config.save_pretrained(out_dir)
+    if getattr(model, "generation_config", None) is not None:
+        model.generation_config.save_pretrained(out_dir)
+    tokenizer.save_pretrained(out_dir)
+
+    # Sanity: only the 7 projections are int4; no transform linears were exported.
+    files = [f for f in os.listdir(out_dir) if f.endswith(".safetensors")]
+    packed, keys = [], []
+    for name in files:
+        with safe_open(os.path.join(out_dir, name), framework="pt") as handle:
+            for key in handle.keys():
+                keys.append(key)
+                if handle.get_slice(key).get_dtype() in ("U8", "I8"):
+                    packed.append(key)
+    stale = [k for k in keys if export_exclude(k)]
+    if stale:
+        raise RuntimeError(f"export kept tensors the runtime never reads: {stale[:5]}")
+    expected = 7 * model.config.num_hidden_layers
+    if len(packed) != expected or any(".linear.weight" not in k for k in packed):
+        raise RuntimeError(f"expected {expected} packed projection weights, got {len(packed)}: {packed[:5]}")
+    return {"files": sorted(files), "tensors": len(keys), "packed_int4": len(packed)}
+
+
+def update_quant_config(out_dir, updates):
+    path = os.path.join(out_dir, "quantization_config.json")
+    with open(path) as handle:
+        cfg = json.load(handle)
+    cfg.update(updates)
+    with open(path, "w") as handle:
+        json.dump(cfg, handle, indent=2)
+
+
+@torch.no_grad()
+def logits_of(model, input_ids):
+    device = model.get_input_embeddings().weight.device
+    out = model(input_ids=input_ids.to(device), use_cache=False)
+    return out.logits.float().cpu()
+
+
+def compare_logits(ref, test):
+    finite = bool(torch.isfinite(test).all())
+    rel = float((test - ref).norm() / ref.norm().clamp(min=1e-12)) if finite else None
+    top1 = float((test.argmax(-1) == ref.argmax(-1)).float().mean()) if finite else None
+    return {"finite": finite, "rel_logit_error": rel, "top1_agreement": top1}
