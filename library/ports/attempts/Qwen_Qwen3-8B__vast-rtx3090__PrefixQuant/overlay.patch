+class LocalJsonlRows:
+    '''
+    Rows of a local JSON-lines file (one {"text": ...} per line) in file order, read lazily by
+    byte offset, optionally permuted. load_dataset("json") yields the same rows in the same order,
+    and Dataset.shuffle(seed) is np.random.default_rng(seed).permutation(len), so
+    LocalJsonlRows(path).shuffle(seed)[i] equals load_dataset(...).shuffle(seed=seed)[i].
+    '''
+    def __init__(self, path, offsets=None, order=None):
+        self.path = path
+        self.offsets = self._index(path) if offsets is None else offsets
+        self.order = order
+
+    @staticmethod
+    def _index(path):
+        cache = path + '.offsets.npy'
+        if os.path.exists(cache) and os.path.getmtime(cache) >= os.path.getmtime(path):
+            return np.load(cache)
+        offsets = []
+        pos = 0
+        with open(path, 'rb') as handle:
+            for line in handle:
+                if line.strip():
+                    offsets.append(pos)
+                pos += len(line)
+        offsets = np.asarray(offsets, dtype=np.int64)
+        try:
+            tmp = cache + f'.{os.getpid()}.tmp.npy'
+            np.save(tmp, offsets)
+            os.replace(tmp, cache)
+        except OSError:
+            pass
+        return offsets
+
+    def shuffle(self, seed):
+        order = np.random.default_rng(seed).permutation(len(self.offsets))
+        return LocalJsonlRows(self.path, self.offsets, order)
+
+    def __len__(self):
+        return len(self.offsets)
+
+    def __getitem__(self, i):
+        row = int(self.order[i]) if self.order is not None else int(i)
+        with open(self.path, 'rb') as handle:
+            handle.seek(int(self.offsets[row]))
+            return json.loads(handle.readline())
