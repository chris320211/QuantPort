new file mode 100644
index 0000000..fd3013a
--- /dev/null
+++ b/quant_agent_inference_adapter.py
@@ -0,0 +1,43 @@
+"""QuantPort inference adapter for PrefixQuant artifacts (W4A4KV4, O1 dynamic or O2 static; fake-quant fp16).
+
+Loads the SAVED artifact at ``model_path`` (never a Hub id): the stock causal-LM class with the
+saved fake-quant fp16 weights, then ``utils.prefix_runtime.attach_quantization`` rebuilds the
+saved quantizer set in the saved mode (static scales, or dynamic per-token/group-wise
+quantizers with their learned clipping factors), the R4 online Hadamard and the R3 RoPE
+wrapper, loads the quantizer state and the fp16 prefix KV, and makes every new sequence start
+from a fresh copy of that prefix.
+The decoder projections are ``QuantLinear`` (an ``nn.Linear`` subclass) whose ``weight`` is the
+fake-quantized fp16 weight. ``generate`` returns sequences without the prefix ids.
+"""
+import os
+import sys
+
+QUANT_AGENT_ADAPTER_API = 1
+
+
+def load_model_and_tokenizer(model_path, model_id, dtype, device, trust_remote_code):
+    here = os.path.dirname(os.path.abspath(__file__))
+    if here not in sys.path:
+        sys.path.insert(0, here)
+    import torch
+    from transformers import AutoModelForCausalLM, AutoTokenizer
+
+    from utils import prefix_runtime
+
+    torch_dtype = torch.bfloat16 if dtype == "bfloat16" else torch.float16
+    if str(device).startswith("cpu"):
+        torch_dtype = torch.float32
+    tokenizer = AutoTokenizer.from_pretrained(
+        model_path, trust_remote_code=trust_remote_code, local_files_only=True
+    )
+    model = AutoModelForCausalLM.from_pretrained(
+        model_path,
+        torch_dtype=torch_dtype,
+        trust_remote_code=trust_remote_code,
+        local_files_only=True,
+        low_cpu_mem_usage=True,
+        device_map={"": device},
+    )
+    model = prefix_runtime.attach_quantization(model, model_path, device=device, dtype=torch_dtype)
+    model.eval()
+    return model, tokenizer
