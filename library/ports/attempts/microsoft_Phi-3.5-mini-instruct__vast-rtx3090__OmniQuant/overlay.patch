@@ -0,0 +1,341 @@
+"""OmniQuant decoder layer for Phi-3 (transformers Phi3DecoderLayer: fused qkv_proj and gate_up_proj).
+
+Same algorithm as models/int_llama_layer.py + quantize/utils.py (LWC on every linear, LET pairs
+[ln1, qkv], [v, o_proj], [Q, K], [ln2, fc1]; per-token activation quantization of every linear
+input and of Q/K/V; softmax output kept at 16 bit), mapped onto Phi-3's fused tensors:
+
+* [ln1, qkv]: one scale over the 3072 inputs of the fused qkv_proj (its only reader).
+* [v, o_proj]: a scale on the v rows of qkv_proj only (rows q_dim+k_dim:), and on o_proj's
+  input columns (repeated over query heads under GQA).
+* [Q, K]: a scale on the q rows / k rows of qkv_proj. It is tied across each RoPE pair
+  (channel j and j + head_dim/2 of a head share one value) so that it commutes exactly with the
+  rotary embedding applied after the projection (rotate_half pairs; LongRoPE only changes the
+  frequencies and a uniform cos/sin factor). An untied scale is not an equivalent transformation
+  for a RoPE model.
+* [ln2, fc1]: one scale over the inputs of the fused gate_up_proj (its only reader).
+* down_proj: no LET (paper section 3.3), unless args.down_let: then a scale on the up rows of
+  gate_up_proj (rows intermediate_size:) and down_proj's input columns. up enters the product
+  act(gate) * up linearly, so this is exact.
+
+Phi-3 has no linear biases and RMSNorm has no bias, so channel-wise shifting is not used
+(as for Llama in quantize/omniquant.py): no bias is created anywhere and the result reloads
+as a native Phi3ForCausalLM.
+"""
+import copy
+import math
+from collections import OrderedDict
+from typing import Optional, Tuple
+
+import torch
+from torch import nn
+from transformers.activations import ACT2FN
+from transformers.models.phi3.modeling_phi3 import apply_rotary_pos_emb, repeat_kv
+
+from models.transformation import truncate_number
+from quantize.int_linear import QuantLinear
+from quantize.int_matmul import QuantMatMul
+from quantize.omni_norm import OmniLlamaRMSNorm
+from quantize.quantizer import UniformAffineQuantizer
+
+
+class FP32ActQuantizer(UniformAffineQuantizer):
+    """The repo's dynamic per-token activation quantizer, evaluated in fp32 and cast back.
+
+    Same math as UniformAffineQuantizer. Under fp16 AMP its backward overflows for rows with a
+    near-zero range (scale clamped at 1e-5, d(x/scale)/d(scale) = -x/scale^2 and 1e-10 underflows
+    in fp16): on Phi-3.5 layer 5 the V quantizer of the PV matmul produced inf gradients on 44 then
+    88 of 128 steps per epoch whatever the loss scale, the GradScaler scale fell from 65536 to
+    2.9e-39 and the next update wrote NaN into every LET/LWC parameter. In fp32 the same steps
+    have finite gradients and the scale stays at 65536.
+    """
+
+    def forward(self, x):
+        if self.lwc or self.n_bits >= 16 or x.dtype == torch.float32:
+            return super().forward(x)
+        return super().forward(x.float()).to(x.dtype)
+
+
+class QuantPhi3MLP(nn.Module):
+    def __init__(self, org_module: nn.Module, config, args=None):
+        super().__init__()
+        self.gate_up_proj = QuantLinear(org_module.gate_up_proj, args.weight_quant_params, args.act_quant_params)
+        self.down_proj = QuantLinear(org_module.down_proj, args.weight_quant_params, args.act_quant_params)
+        self.act_fn = ACT2FN[config.hidden_act]
+
+    def forward(self, x):
+        up_states = self.gate_up_proj(x)
+        gate, up_states = up_states.chunk(2, dim=-1)
+        return self.down_proj(up_states * self.act_fn(gate))
+
+
+class QuantPhi3Attention(nn.Module):
+    def __init__(self, org_module: nn.Module, config, args=None):
+        super().__init__()
+        self.config = config
+        self.hidden_size = config.hidden_size
+        self.num_heads = config.num_attention_heads
+        self.head_dim = self.hidden_size // self.num_heads
+        self.num_key_value_heads = config.num_key_value_heads
+        self.num_key_value_groups = self.num_heads // self.num_key_value_heads
+        if self.head_dim % 2:
+            raise ValueError(f"head_dim {self.head_dim} must be even for RoPE pairs")
+        self.q_dim = self.num_heads * self.head_dim
+        self.kv_dim = self.num_key_value_heads * self.head_dim
+        if org_module.qkv_proj.out_features != self.q_dim + 2 * self.kv_dim:
+            raise ValueError("qkv_proj rows are not [q | k | v]")
+        self.rotary_emb = copy.deepcopy(org_module.rotary_emb)
+        self.qkv_proj = QuantLinear(org_module.qkv_proj, args.weight_quant_params, args.act_quant_params)
+        self.o_proj = QuantLinear(org_module.o_proj, args.weight_quant_params, args.act_quant_params)
+        self.qkt_matmul = QuantMatMul(args.q_quant_params, args.k_quant_params, matmul_func=torch.matmul)
+        self.pv_matmul = QuantMatMul(args.p_quant_params, args.v_quant_params, matmul_func=torch.matmul)
+        self.use_weight_quant = False
+        self.use_act_quant = False
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        attention_mask: Optional[torch.Tensor] = None,
+        position_ids: Optional[torch.LongTensor] = None,
+        past_key_value=None,
+        output_attentions: bool = False,
+        use_cache: bool = False,
+        **kwargs,
+    ) -> Tuple[torch.Tensor, Optional[torch.Tensor], None]:
+        if past_key_value is not None or use_cache:
+            raise NotImplementedError("QuantPhi3Attention is the calibration layer; it has no KV cache")
+        bsz, q_len, _ = hidden_states.size()
+        qkv = self.qkv_proj(hidden_states)
+        query_states = qkv[..., : self.q_dim]
+        key_states = qkv[..., self.q_dim : self.q_dim + self.kv_dim]
+        value_states = qkv[..., self.q_dim + self.kv_dim :]
+        query_states = query_states.reshape(bsz, q_len, self.num_heads, self.head_dim).transpose(1, 2)
+        key_states = key_states.reshape(bsz, q_len, self.num_key_value_heads, self.head_dim).transpose(1, 2)
+        value_states = value_states.reshape(bsz, q_len, self.num_key_value_heads, self.head_dim).transpose(1, 2)
+
+        if position_ids is None:
+            position_ids = torch.arange(q_len, device=hidden_states.device).unsqueeze(0)
+        cos, sin = self.rotary_emb(value_states, position_ids, seq_len=q_len)
+        query_states, key_states = apply_rotary_pos_emb(query_states, key_states, cos, sin)
+
+        key_states = repeat_kv(key_states, self.num_key_value_groups)
+        value_states = repeat_kv(value_states, self.num_key_value_groups)
+
+        query_states = self.qkt_matmul.quant_x1(query_states)
+        key_states = self.qkt_matmul.quant_x2(key_states)
+        attn_weights = self.qkt_matmul(query_states, key_states.transpose(2, 3)) / math.sqrt(self.head_dim)
+        if attention_mask is not None:
+            attn_weights = attn_weights + attention_mask[:, :, :, : key_states.shape[-2]].to(attn_weights.dtype)
+            attn_weights = torch.max(attn_weights, torch.tensor(torch.finfo(attn_weights.dtype).min, device=attn_weights.device))
+        else:
+            causal = torch.ones(q_len, q_len, dtype=torch.bool, device=attn_weights.device).tril()
+            attn_weights = attn_weights.masked_fill(~causal, torch.finfo(attn_weights.dtype).min)
+
+        attn_weights = nn.functional.softmax(attn_weights, dim=-1, dtype=torch.float32).to(query_states.dtype)
+        attn_weights = self.pv_matmul.quant_x1(attn_weights)
+        value_states = self.pv_matmul.quant_x2(value_states)
+        attn_output = self.pv_matmul(attn_weights, value_states)
+        attn_output = attn_output.transpose(1, 2).reshape(bsz, q_len, self.hidden_size)
+        attn_output = self.o_proj(attn_output)
+        return attn_output, None, None
+
+    def set_quant_state(self, weight_quant: bool = False, act_quant: bool = False):
+        self.use_weight_quant = weight_quant
+        self.use_act_quant = act_quant
+        for m in self.modules():
+            if isinstance(m, (QuantLinear, QuantMatMul)):
+                m.set_quant_state(weight_quant, act_quant)
+
+
+class QuantPhi3DecoderLayer(nn.Module):
+    """Phi3DecoderLayer with QuantLinear / QuantMatMul and the LET pairs above."""
+
+    omni_family = "phi3"
+
+    def __init__(self, config, ori_layer, args):
+        super().__init__()
+        self.hidden_size = config.hidden_size
+        self.intermediate_size = config.intermediate_size
+        self.self_attn = QuantPhi3Attention(org_module=ori_layer.self_attn, config=config, args=args)
+        self.mlp = QuantPhi3MLP(org_module=ori_layer.mlp, config=config, args=args)
+        self.input_layernorm = OmniLlamaRMSNorm(ori_layer.input_layernorm, eps=ori_layer.input_layernorm.variance_epsilon)
+        self.post_attention_layernorm = OmniLlamaRMSNorm(
+            ori_layer.post_attention_layernorm, eps=ori_layer.post_attention_layernorm.variance_epsilon
+        )
+        self.down_let = bool(getattr(args, "down_let", False))
+        self.let = False
+        for module in self.modules():
+            if type(module) is UniformAffineQuantizer and not module.lwc:
+                module.__class__ = FP32ActQuantizer  # activation (and Q/K/V) quantizers only
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        attention_mask: Optional[torch.Tensor] = None,
+        position_ids: Optional[torch.LongTensor] = None,
+        past_key_value=None,
+        output_attentions: Optional[bool] = False,
+        use_cache: Optional[bool] = False,
+        **kwargs,
+    ):
+        residual = hidden_states
+        hidden_states = self.input_layernorm(hidden_states)
+        attn_out, _, _ = self.self_attn(
+            hidden_states=hidden_states, attention_mask=attention_mask, position_ids=position_ids,
+        )
+        hidden_states = residual + attn_out
+        residual = hidden_states
+        hidden_states = self.post_attention_layernorm(hidden_states)
+        hidden_states = self.mlp(hidden_states)
+        hidden_states = residual + hidden_states
+        return (hidden_states,)
+
+    def set_quant_state(self, weight_quant: bool = False, act_quant: bool = False):
+        self.use_weight_quant = weight_quant
+        self.use_act_quant = act_quant
+        for m in self.modules():
+            if isinstance(m, (QuantLinear, QuantMatMul)):
+                m.set_quant_state(weight_quant, act_quant)
+
+    # --- LET -----------------------------------------------------------------------------
+
+    @torch.no_grad()
+    def init_let(self, act_scales, prefix, alpha, dev, dtype):
+        """SmoothQuant initialisation of every LET scale (quantize/omniquant.py:224-237)."""
+        attn = self.self_attn
+
+        def smooth(key, weight):
+            if key not in act_scales:
+                raise KeyError(f"no activation scales for {key}")
+            act = act_scales[key].to(device=dev, dtype=dtype).clamp(min=1e-5)
+            w = weight.abs().max(dim=0)[0].to(device=dev, dtype=dtype).clamp(min=1e-5)
+            return (act.pow(alpha) / w.pow(1 - alpha)).clamp(min=1e-5)
+
+        qkv_scale = smooth(f"{prefix}.self_attn.qkv_proj", attn.qkv_proj.weight)
+        out_scale = smooth(f"{prefix}.self_attn.o_proj", attn.o_proj.weight)
+        if attn.num_key_value_groups > 1:
+            # one scale per v channel: the largest over the query heads that read it
+            out_scale = out_scale.view(attn.num_key_value_heads, attn.num_key_value_groups, attn.head_dim).amax(1).reshape(-1)
+        fc1_scale = smooth(f"{prefix}.mlp.gate_up_proj", self.mlp.gate_up_proj.weight)
+        qkt_scale = torch.ones(attn.num_key_value_heads, attn.head_dim // 2, device=dev, dtype=dtype)
+        self.register_parameter("qkv_smooth_scale", nn.Parameter(qkv_scale))
+        self.register_parameter("out_smooth_scale", nn.Parameter(out_scale))
+        self.register_parameter("qkt_smooth_scale", nn.Parameter(qkt_scale))
+        self.register_parameter("fc1_smooth_scale", nn.Parameter(fc1_scale))
+        if self.down_let:
+            down_scale = smooth(f"{prefix}.mlp.down_proj", self.mlp.down_proj.weight)
+            self.register_parameter("down_smooth_scale", nn.Parameter(down_scale))
+
+    def _expanded_scales(self):
+        """Per-row / per-column scale vectors for the fused tensors."""
+        attn = self.self_attn
+        n_kv, n_rep, d = attn.num_key_value_heads, attn.num_key_value_groups, attn.head_dim
+        k_scale = torch.cat([self.qkt_smooth_scale, self.qkt_smooth_scale], dim=-1)  # RoPE pairs (j, j + d/2)
+        q_scale = k_scale.view(n_kv, 1, d).expand(n_kv, n_rep, d).reshape(-1)
+        k_scale = k_scale.reshape(-1)
+        v_scale = self.out_smooth_scale
+        o_scale = v_scale.view(n_kv, 1, d).expand(n_kv, n_rep, d).reshape(-1)
+        return q_scale, k_scale, v_scale, o_scale
+
+    def _transformed_weights(self):
+        """Every LET folded into the weights it touches (autograd-friendly, no in-place)."""
+        attn, mlp = self.self_attn, self.mlp
+        q_scale, k_scale, v_scale, o_scale = self._expanded_scales()
+        w = attn.qkv_proj.weight * self.qkv_smooth_scale.view(1, -1)
+        wq, wk, wv = w.split([attn.q_dim, attn.kv_dim, attn.kv_dim], dim=0)
+        qkv = torch.cat([wq / q_scale.view(-1, 1), wk * k_scale.view(-1, 1), wv / v_scale.view(-1, 1)], dim=0)
+        o = attn.o_proj.weight * o_scale.view(1, -1)
+        gate_up = mlp.gate_up_proj.weight * self.fc1_smooth_scale.view(1, -1)
+        down = mlp.down_proj.weight
+        if self.down_let:
+            gate, up = gate_up.split([self.intermediate_size, self.intermediate_size], dim=0)
+            gate_up = torch.cat([gate, up / self.down_smooth_scale.view(-1, 1)], dim=0)
+            down = down * self.down_smooth_scale.view(1, -1)
+        ln1 = self.input_layernorm.weight / self.qkv_smooth_scale
+        ln2 = self.post_attention_layernorm.weight / self.fc1_smooth_scale
+        return ln1, qkv, o, ln2, gate_up, down
+
+    def _truncate_scales(self):
+        with torch.no_grad():
+            for name, param in self.named_parameters():
+                if "smooth_scale" in name:
+                    param.data = truncate_number(param)
+
+    def smooth_and_quant_temporary(self):
+        """quantize/utils.py:62-101 for the Phi-3 layout."""
+        attn, mlp = self.self_attn, self.mlp
+        if self.let:
+            self._truncate_scales()
+            ln1, qkv, o, ln2, gate_up, down = self._transformed_weights()
+            for norm, weight in ((self.input_layernorm, ln1), (self.post_attention_layernorm, ln2)):
+                norm.use_temporary_parameter = True
+                norm.temp_weight = weight
+                norm.temp_bias = None
+            for module, weight in ((attn.qkv_proj, qkv), (attn.o_proj, o), (mlp.gate_up_proj, gate_up), (mlp.down_proj, down)):
+                module.temp_weight = weight
+        else:
+            for module in self.modules():
+                if isinstance(module, QuantLinear):
+                    module.temp_weight = module.weight
+        for module in self.modules():
+            if isinstance(module, QuantLinear):
+                module.temp_weight = module.weight_quantizer(module.temp_weight)
+                module.temp_bias = module.bias
+                module.use_temporary_parameter = True
+
+    @torch.no_grad()
+    def smooth_and_quant_inplace(self):
+        """quantize/utils.py:111-136 for the Phi-3 layout: fold the LETs, then fake-quantize."""
+        attn, mlp = self.self_attn, self.mlp
+        if self.let:
+            self._truncate_scales()
+            # detach(): a weight left unchanged is still the original nn.Parameter object, and
+            # assigning a Parameter would re-register it as a parameter instead of a buffer.
+            ln1, qkv, o, ln2, gate_up, down = (t.detach() for t in self._transformed_weights())
+            self.input_layernorm.weight = ln1
+            self.post_attention_layernorm.weight = ln2
+            self.input_layernorm.use_temporary_parameter = False
+            self.post_attention_layernorm.use_temporary_parameter = False
+            attn.qkv_proj.weight = qkv
+            attn.o_proj.weight = o
+            mlp.gate_up_proj.weight = gate_up
+            mlp.down_proj.weight = down
+        for module in self.modules():
+            if isinstance(module, QuantLinear):
+                module.weight = module.weight_quantizer(module.weight).detach()
+                module.use_temporary_parameter = False
+
+    def clear_temp_variable(self):
+        for module in self.modules():
+            for attr in ("temp_weight", "temp_bias"):
+                if hasattr(module, attr):
+                    delattr(module, attr)
+            if hasattr(module, "use_temporary_parameter"):
+                module.use_temporary_parameter = False
+
+    def omni_state_dict(self, destination=None, prefix="", keep_vars=False):
+        if destination is None:
+            destination = OrderedDict()
+        for name, param in self.named_parameters():
+            if name.find("smooth") > -1 or name.find("bound_factor") > -1:
+                destination[prefix + name] = param if keep_vars else param.detach()
+        return destination
+
+    @torch.no_grad()
+    def to_native(self, native_layer):
+        """Copy the folded, fake-quantized tensors into a fresh transformers Phi3DecoderLayer."""
+        pairs = (
+            (native_layer.input_layernorm.weight, self.input_layernorm.weight),
+            (native_layer.post_attention_layernorm.weight, self.post_attention_layernorm.weight),
+            (native_layer.self_attn.qkv_proj.weight, self.self_attn.qkv_proj.weight),
+            (native_layer.self_attn.o_proj.weight, self.self_attn.o_proj.weight),
+            (native_layer.mlp.gate_up_proj.weight, self.mlp.gate_up_proj.weight),
+            (native_layer.mlp.down_proj.weight, self.mlp.down_proj.weight),
+        )
+        for dst, src in pairs:
+            if dst.shape != src.shape:
+                raise ValueError(f"shape mismatch {tuple(dst.shape)} vs {tuple(src.shape)}")
+            dst.copy_(src.to(dst.dtype))
+        for module in self.modules():
+            if isinstance(module, QuantLinear) and module.bias is not None:
+                raise ValueError("a Phi-3 linear gained a bias; the native layer cannot hold it")
+        return native_layer
