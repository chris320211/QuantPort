@@ -0,0 +1,180 @@
+"""Reload an OmniQuant W4A4 Phi-3 artifact with its activation quantization.
+
+The artifact (quantize/phi3_export.py) is the repo's own ``--save_dir`` format: a native
+Phi3ForCausalLM checkpoint whose decoder linears hold fake-quantized fp16 weights (4-bit
+asymmetric per output channel with the learned clipping, every LET folded into the norms and
+weights). Saving drops OmniQuant's activation quantizers, so loading it with plain transformers
+would run W4A16. This adapter puts them back, as QuantLinear / QuantMatMul run them in the repo
+(quantize/quantizer.py:118-159, dynamic asymmetric MinMax, ``a_bits`` levels):
+
+* the input of every decoder linear (qkv_proj, o_proj, gate_up_proj, down_proj): per token;
+* Q and K after the rotary embedding, and V: per token and per head (head_dim values),
+  as models/int_llama_layer.py:141-162 does; the softmax output stays 16-bit.
+
+The quantizer arithmetic runs in fp32 and is cast back to fp16, as the calibration layer's
+FP32ActQuantizer (models/int_phi3_layer.py) does.
+
+Per-token quantization of K/V commutes with caching and with repeat_kv, so K/V are quantized
+once before they enter the cache. Quantizer arithmetic, the RMSNorm product order and the eager
+attention follow the calibration layer (models/int_phi3_layer.py) op for op, because a W4A4 model
+amplifies one-level rounding flips: a reload of the same weights with SDPA and a different
+quantizer dtype than calibration differed from the calibrated model by ~0.3 relative logit error on
+two layers (with the same quality versus fp16). There is no packed A4 kernel in the repo; this is fake quantization in fp16 (no VRAM or
+speed gain).
+
+The model is always built with the native transformers class: the artifact has no auto_map and
+no modeling code, so remote code is never loaded whatever ``trust_remote_code`` says.
+"""
+import json
+import math
+import os
+import types
+
+import torch
+import torch.nn.functional as F
+
+QUANT_AGENT_ADAPTER_API = 1
+QUANT_CONFIG_NAME = "quantization_config.json"
+LINEAR_NAMES = ("self_attn.qkv_proj", "self_attn.o_proj", "mlp.gate_up_proj", "mlp.down_proj")
+
+
+def fake_quant_per_token(x, n_bits):
+    """UniformAffineQuantizer(symmetric=False, dynamic per_token) over the last dim.
+
+    Same op order as quantize/quantizer.py:94-159, evaluated in fp32 and cast back to the
+    activation dtype exactly as models/int_phi3_layer.py FP32ActQuantizer does in calibration,
+    so the reload reproduces the calibrated model's rounding.
+    """
+    if n_bits >= 16:
+        return x
+    out_dtype = x.dtype
+    x = x.float()
+    qmax = 2 ** n_bits - 1
+    xmin = x.amin(dim=-1, keepdim=True)
+    xmax = x.amax(dim=-1, keepdim=True)
+    scale = ((xmax - xmin) / qmax).clamp(min=1e-5, max=1e4)
+    round_zero = (-xmin / scale).clamp(min=-1e4, max=1e4).round()
+    x_int = torch.round(x / scale).add(round_zero).clamp(0, qmax)
+    return x_int.sub(round_zero).mul(scale).to(out_dtype)
+
+
+def _omni_rmsnorm_forward(self, hidden_states):
+    """quantize/omni_norm.py OmniLlamaRMSNorm: the weight multiplies the fp32 normalised states."""
+    input_dtype = hidden_states.dtype
+    variance = hidden_states.to(torch.float32).pow(2).mean(-1, keepdim=True)
+    hidden_states = hidden_states * torch.rsqrt(variance + self.variance_epsilon)
+    return (self.weight * hidden_states).to(input_dtype)
+
+
+def _a4_linear_forward(self, x):
+    return F.linear(fake_quant_per_token(x, self.omniquant_a_bits), self.weight, self.bias)
+
+
+def _a4_attention_forward(
+    self,
+    hidden_states,
+    attention_mask=None,
+    position_ids=None,
+    past_key_value=None,
+    output_attentions=False,
+    use_cache=False,
+    cache_position=None,
+    **kwargs,
+):
+    from transformers.models.phi3.modeling_phi3 import apply_rotary_pos_emb, repeat_kv
+
+    bsz, q_len, _ = hidden_states.size()
+    qkv = self.qkv_proj(hidden_states)
+    query_pos = self.num_heads * self.head_dim
+    kv_width = self.num_key_value_heads * self.head_dim
+    query_states = qkv[..., :query_pos]
+    key_states = qkv[..., query_pos : query_pos + kv_width]
+    value_states = qkv[..., query_pos + kv_width :]
+    query_states = query_states.view(bsz, q_len, self.num_heads, self.head_dim).transpose(1, 2)
+    key_states = key_states.view(bsz, q_len, self.num_key_value_heads, self.head_dim).transpose(1, 2)
+    value_states = value_states.view(bsz, q_len, self.num_key_value_heads, self.head_dim).transpose(1, 2)
+
+    kv_seq_len = key_states.shape[-2]
+    if past_key_value is not None:
+        kv_seq_len += past_key_value.get_usable_length(kv_seq_len, self.layer_idx)
+    cos, sin = self.rotary_emb(value_states, position_ids, seq_len=kv_seq_len)
+    query_states, key_states = apply_rotary_pos_emb(query_states, key_states, cos, sin)
+
+    bits = self.omniquant_qkv_bits
+    query_states = fake_quant_per_token(query_states, bits)
+    key_states = fake_quant_per_token(key_states, bits)
+    value_states = fake_quant_per_token(value_states, bits)
+
+    if past_key_value is not None:
+        cache_kwargs = {"sin": sin, "cos": cos, "cache_position": cache_position}
+        key_states, value_states = past_key_value.update(key_states, value_states, self.layer_idx, cache_kwargs)
+
+    key_states = repeat_kv(key_states, self.num_key_value_groups)
+    value_states = repeat_kv(value_states, self.num_key_value_groups)
+
+    # Eager attention exactly as models/int_phi3_layer.py (int_llama_layer.py:141-163): fp16 QK^T,
+    # additive causal mask, fp32 softmax cast back, softmax output kept 16-bit.
+    attn_weights = torch.matmul(query_states, key_states.transpose(2, 3)) / math.sqrt(self.head_dim)
+    if attention_mask is not None:
+        attn_weights = attn_weights + attention_mask[:, :, :, : key_states.shape[-2]].to(attn_weights.dtype)
+        attn_weights = torch.max(attn_weights, torch.tensor(torch.finfo(attn_weights.dtype).min, device=attn_weights.device))
+    elif q_len > 1:
+        kv_len = key_states.shape[-2]
+        causal = torch.ones(q_len, kv_len, dtype=torch.bool, device=attn_weights.device).tril(kv_len - q_len)
+        attn_weights = attn_weights.masked_fill(~causal, torch.finfo(attn_weights.dtype).min)
+    attn_weights = torch.softmax(attn_weights, dim=-1, dtype=torch.float32).to(query_states.dtype)
+    attn_output = torch.matmul(attn_weights, value_states)
+    attn_output = attn_output.transpose(1, 2).contiguous().view(bsz, q_len, self.hidden_size)
+    attn_output = self.o_proj(attn_output)
+    return attn_output, None, past_key_value
+
+
+def apply_activation_quant(model, a_bits, qkv_bits):
+    """Re-attach OmniQuant's runtime activation quantization to a loaded Phi-3 model."""
+    patched = 0
+    for layer in model.model.layers:
+        attn = layer.self_attn
+        for name in LINEAR_NAMES:
+            module = layer.get_submodule(name)
+            if not isinstance(module, torch.nn.Linear):
+                raise TypeError(f"{name} is {type(module).__name__}, expected nn.Linear")
+            module.omniquant_a_bits = int(a_bits)
+            module.forward = types.MethodType(_a4_linear_forward, module)
+            patched += 1
+        attn.omniquant_qkv_bits = int(qkv_bits)
+        attn.forward = types.MethodType(_a4_attention_forward, attn)
+        for norm in (layer.input_layernorm, layer.post_attention_layernorm):
+            norm.forward = types.MethodType(_omni_rmsnorm_forward, norm)
+    return patched
+
+
+def load_model_and_tokenizer(model_path, model_id, dtype, device, trust_remote_code):
+    from transformers import AutoTokenizer
+    from transformers.models.phi3.modeling_phi3 import Phi3ForCausalLM
+
+    del model_id, trust_remote_code  # the saved artifact is loaded natively, never remote code
+    with open(os.path.join(model_path, QUANT_CONFIG_NAME)) as handle:
+        quant_config = json.load(handle)
+    a_bits = int(quant_config.get("a_bits", 16))
+    qkv_bits = int(quant_config.get("qkv_bits", a_bits))
+    on_cuda = str(device).startswith("cuda") and torch.cuda.is_available()
+    if dtype == "bfloat16":
+        print("omniquant adapter: fake-quant weights are stored in float16; loading float16, not bfloat16")
+    torch_dtype = torch.float16 if on_cuda else torch.float32
+    tokenizer = AutoTokenizer.from_pretrained(model_path, local_files_only=True)
+    model = Phi3ForCausalLM.from_pretrained(
+        model_path,
+        torch_dtype=torch_dtype,
+        attn_implementation="eager",
+        local_files_only=True,
+    )
+    model.to("cuda" if on_cuda else "cpu")
+    patched = apply_activation_quant(model, a_bits, qkv_bits)
+    model.eval()
+    model.omniquant_runtime = {
+        "a_bits": a_bits,
+        "qkv_bits": qkv_bits,
+        "patched_linears": patched,
+        "attention": "eager on fake-quantized Q/K/V (as calibrated)",
+    }
+    return model, tokenizer
