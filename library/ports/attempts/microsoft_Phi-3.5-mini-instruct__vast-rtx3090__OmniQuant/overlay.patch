@@ -0,0 +1,75 @@
+"""Calibration data and fake-quant export for the Phi-3 OmniQuant path.
+
+* get_wikitext2_local: datautils.get_wikitext2's trainloader (random 2048-token windows of the
+  "\\n\\n"-joined WikiText-2 train split, python ``random`` seeded with ``seed``), read from a local
+  parquet file instead of ``load_dataset`` so jobs never touch the Hub.
+* export_phi3_fakequant: main.py's ``--save_dir`` artifact (fake-quantized fp16 weights with every
+  LET folded in) written as a native Phi3ForCausalLM checkpoint: each QuantPhi3DecoderLayer is
+  copied back into a transformers Phi3DecoderLayer, ``auto_map`` is stripped from config.json so
+  the artifact never needs remote code, and quantization_config.json records the activation
+  quantization the reload must re-apply (A4 per-token linear inputs and Q/K/V).
+"""
+import json
+import os
+import random
+
+import torch
+
+
+def get_wikitext2_local(parquet_path, tokenizer, nsamples, seed, seqlen):
+    import pyarrow.parquet as pq
+
+    texts = pq.read_table(parquet_path, columns=["text"]).column("text").to_pylist()
+    trainenc = tokenizer("\n\n".join(texts), return_tensors="pt")
+    total = trainenc.input_ids.shape[1]
+    if total <= seqlen + 1:
+        raise ValueError(f"wikitext2 train has {total} tokens, fewer than seqlen {seqlen}")
+    random.seed(seed)
+    trainloader = []
+    for _ in range(nsamples):
+        i = random.randint(0, total - seqlen - 1)
+        inp = trainenc.input_ids[:, i : i + seqlen]
+        tar = inp.clone()
+        tar[:, :-1] = -100
+        trainloader.append((inp, tar))
+    return trainloader
+
+
+@torch.no_grad()
+def export_phi3_fakequant(model, tokenizer, output_dir, quant_config):
+    from transformers.models.phi3.modeling_phi3 import Phi3DecoderLayer
+
+    from models.int_phi3_layer import QuantPhi3DecoderLayer
+
+    layers = model.model.layers
+    converted = 0
+    for idx in range(len(layers)):
+        qlayer = layers[idx]
+        if not isinstance(qlayer, QuantPhi3DecoderLayer):
+            raise TypeError(f"layer {idx} is {type(qlayer).__name__}, not QuantPhi3DecoderLayer")
+        native = Phi3DecoderLayer(model.config, layer_idx=idx).to(dtype=torch.float16)
+        layers[idx] = qlayer.to_native(native).eval()
+        converted += 1
+        del qlayer
+    model.to(torch.float16)
+    model.config.use_cache = True
+    os.makedirs(output_dir, exist_ok=True)
+    model.save_pretrained(output_dir, safe_serialization=True)
+    tokenizer.save_pretrained(output_dir)
+
+    config_path = os.path.join(output_dir, "config.json")
+    with open(config_path) as handle:
+        config = json.load(handle)
+    config.pop("auto_map", None)
+    config["torch_dtype"] = "float16"
+    config["use_cache"] = True
+    with open(config_path, "w") as handle:
+        json.dump(config, handle, indent=2)
+    for stale in ("configuration_phi3.py", "modeling_phi3.py"):
+        path = os.path.join(output_dir, stale)
+        if os.path.exists(path):
+            os.remove(path)
+
+    with open(os.path.join(output_dir, "quantization_config.json"), "w") as handle:
+        json.dump(quant_config, handle, indent=2)
+    return {"layers": converted, "output_dir": os.path.abspath(output_dir), "files": sorted(os.listdir(output_dir))}
