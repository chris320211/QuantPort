+++ b/duquant_port/kernels.py
@@ -0,0 +1,260 @@
+"""Triton kernels for the DuQuant integer format ``duquant_w4a4_int8_storage``.
+
+DuQuant quantizes asymmetrically (weights per output channel, activations per token, 4 bits, integer
+zero points: ``round(-xmin / scale)``). For a 4-bit code q in [0, 15] and an integer zero z the
+dequantized value is ``s * (q - z)``, so
+
+    Y[m, n] = s_x[m] * s_w[n] * sum_k (q_x[m, k] - z_x[m]) * c_w[n, k]
+            = s_x[m] * s_w[n] * (sum_k q_x[m, k] * c_w[n, k]  -  z_x[m] * rowsum(c_w)[n])
+
+with the weight codes stored centred, ``c_w = q_w - z_w`` (int8, in [-15, 15] for any row that spans
+zero). The int8 x int8 -> int32 tensor-core GEMM computes the first sum exactly; the zero-point term is
+an exact int32 rank-1 correction in the epilogue. No approximation for ANY integer z_x (a token whose
+values are all positive has z_x < 0 and codes q - z_x outside int8; the correction keeps that exact too).
+
+Kernels:
+1. ``_asym_codes_kernel`` / ``_asym_codes_looped_kernel``: per-token asymmetric quantizer of a linear's
+   (already rotated, fp32) input -> uint4 codes in int8 lanes, fp32 scale, int32 zero. Bit-identical to
+   ``runtime.fake_quant_per_token`` (fp32: min/max, * lac, / 15, clamp, IEEE division, round half even).
+2. ``_asym_fake_quant_rows_kernel``: the same quantizer as fake quant (fp16/fp32 in, fp16 out) over many
+   short rows at once: per-(token, head) Q/K (after the Hadamard) and V (head_dim = 128).
+3. ``_w4a4_azp_gemm_kernel``: the shared ``w8a8_int8`` Triton GEMM (same tiling/configs, from
+   ``triton_w8a8.py`` copied unchanged) plus the zero-point epilogue above.
+4. ``_gather_cols_kernel``: the DuQuant zigzag permutation between R1 and R2 as a row gather (exact data
+   movement, ~1.5x faster than index_select at these shapes).
+torch computes ``tensor / qmax`` (Python-scalar divisor) as a multiply by the fp32 reciprocal and every
+other division IEEE-exactly; the kernels mirror that with explicitly rounded ops (no FMA contraction).
+Triton value arguments are Python floats/ints (0-d tensors would compile as pointers).
+"""
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+try:  # triton >= 3.0
+    from triton.language.extra import libdevice
+except ImportError:  # pragma: no cover - older layouts
+    from triton.language.extra.cuda import libdevice
+
+from . import triton_w8a8
+
+@triton.jit
+def _asym_params(xmin, xmax, clip, inv_qmax, HAS_CLIP: tl.constexpr):
+    """fp32, torch order: (min, max) * clip -> (max - min) / qmax -> clamp -> zero = round(clamp(-min / s)).
+
+    Every product/difference/quotient is an explicitly rounded op (mul_rn / sub_rn / div_rn): LLVM would
+    otherwise contract ``max*c - min*c`` into an FMA and change the last bit of the scale."""
+    if HAS_CLIP:
+        xmin = libdevice.mul_rn(xmin, clip)
+        xmax = libdevice.mul_rn(xmax, clip)
+    # torch computes ``tensor / qmax`` (Python-scalar divisor) as a multiply by the fp32 reciprocal
+    scale = libdevice.mul_rn(libdevice.sub_rn(xmax, xmin), inv_qmax)
+    scale = tl.minimum(tl.maximum(scale, 1e-5), 1e4)
+    zero = tl.math.div_rn(-xmin, scale)
+    zero = libdevice.rint(tl.minimum(tl.maximum(zero, -1e4), 1e4))
+    return scale, zero
+
+
+@triton.jit
+def _asym_q(x, scale, zero, QMAX: tl.constexpr):
+    """clamp(round(x / s) + z, 0, qmax) with IEEE division and round half to even (torch.round)."""
+    q = libdevice.add_rn(libdevice.rint(tl.math.div_rn(x, scale)), zero)
+    return tl.minimum(tl.maximum(q, 0.0), QMAX)
+
+
+@triton.jit
+def _asym_codes_kernel(x_ptr, q_ptr, s_ptr, z_ptr, K, stride_x, stride_q, clip, inv_qmax,
+                       HAS_CLIP: tl.constexpr, QMAX: tl.constexpr, BLOCK_K: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    offs = tl.arange(0, BLOCK_K)
+    mask = offs < K
+    x = tl.load(x_ptr + row * stride_x + offs, mask=mask, other=0.0).to(tl.float32)
+    xmin = tl.min(tl.where(mask, x, float("inf")), axis=0)
+    xmax = tl.max(tl.where(mask, x, float("-inf")), axis=0)
+    scale, zero = _asym_params(xmin, xmax, clip, inv_qmax, HAS_CLIP)
+    q = _asym_q(x, scale, zero, QMAX)
+    tl.store(q_ptr + row * stride_q + offs, q.to(tl.int8), mask=mask)
+    tl.store(s_ptr + row, scale)
+    tl.store(z_ptr + row, zero.to(tl.int32))
+
+
+@triton.jit
+def _asym_codes_looped_kernel(x_ptr, q_ptr, s_ptr, z_ptr, K, stride_x, stride_q, clip, inv_qmax,
+                              HAS_CLIP: tl.constexpr, QMAX: tl.constexpr, BLOCK_K: tl.constexpr):
+    """Long rows (K > BLOCK_K): min/max pass, then the code pass (second read hits L2)."""
+    row = tl.program_id(0).to(tl.int64)
+    x_row = x_ptr + row * stride_x
+    q_row = q_ptr + row * stride_q
+    offs = tl.arange(0, BLOCK_K)
+    run_min = tl.full((BLOCK_K,), float("inf"), tl.float32)
+    run_max = tl.full((BLOCK_K,), float("-inf"), tl.float32)
+    for k0 in range(0, K, BLOCK_K):
+        mask = (k0 + offs) < K
+        x = tl.load(x_row + k0 + offs, mask=mask, other=0.0).to(tl.float32)
+        run_min = tl.minimum(run_min, tl.where(mask, x, float("inf")))
+        run_max = tl.maximum(run_max, tl.where(mask, x, float("-inf")))
+    scale, zero = _asym_params(tl.min(run_min, axis=0), tl.max(run_max, axis=0), clip, inv_qmax, HAS_CLIP)
+    for k0 in range(0, K, BLOCK_K):
+        mask = (k0 + offs) < K
+        x = tl.load(x_row + k0 + offs, mask=mask, other=0.0).to(tl.float32)
+        tl.store(q_row + k0 + offs, _asym_q(x, scale, zero, QMAX).to(tl.int8), mask=mask)
+    tl.store(s_ptr + row, scale)
+    tl.store(z_ptr + row, zero.to(tl.int32))
+
+
+@triton.jit
+def _asym_fake_quant_rows_kernel(x_ptr, y_ptr, n_rows, clip, inv_qmax,
+                                 HAS_CLIP: tl.constexpr, QMAX: tl.constexpr, D: tl.constexpr,
+                                 ROWS: tl.constexpr):
+    """y = ((q - z) * s).to(y.dtype) per row of D contiguous values (runtime.fake_quant_per_token)."""
+    pid = tl.program_id(0).to(tl.int64)
+    rows = pid * ROWS + tl.arange(0, ROWS)
+    cols = tl.arange(0, D)
+    rmask = rows < n_rows
+    ptrs = rows[:, None] * D + cols[None, :]
+    x = tl.load(x_ptr + ptrs, mask=rmask[:, None], other=0.0).to(tl.float32)
+    scale, zero = _asym_params(tl.min(x, axis=1), tl.max(x, axis=1), clip, inv_qmax, HAS_CLIP)
+    q = _asym_q(x, scale[:, None], zero[:, None], QMAX)
+    y = libdevice.mul_rn(libdevice.sub_rn(q, zero[:, None]), scale[:, None])
+    tl.store(y_ptr + ptrs, y.to(y_ptr.dtype.element_ty), mask=rmask[:, None])
+
+
+@triton.jit
+def _gather_cols_kernel(x_ptr, p_ptr, y_ptr, K, stride_x, stride_y, BLOCK: tl.constexpr):
+    """y[m, j] = x[m, perm[j]]: one program per row, the whole row's indices at once (row stays in L1/L2)."""
+    row = tl.program_id(0).to(tl.int64)
+    cols = tl.arange(0, BLOCK)
+    mask = cols < K
+    src = tl.load(p_ptr + cols, mask=mask, other=0)
+    v = tl.load(x_ptr + row * stride_x + src, mask=mask)
+    tl.store(y_ptr + row * stride_y + cols, v, mask=mask)
+
+
+@triton.jit
+def _w4a4_azp_gemm_kernel(
+    a_ptr, b_ptr, c_ptr, as_ptr, az_ptr, bs_ptr, brs_ptr,
+    M, N, K,
+    stride_am, stride_ak, stride_bn, stride_bk, stride_cm, stride_cn,
+    EVEN_K: tl.constexpr,
+    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr,
+):
+    """C = ((A_u4[M,K] @ B_c[N,K]^T) - a_zero[M] * b_rowsum[N]) * a_scale[M] * b_scale[N] (int32 exact)."""
+    pid = tl.program_id(0)
+    num_pid_m = tl.cdiv(M, BLOCK_M)
+    num_pid_n = tl.cdiv(N, BLOCK_N)
+    num_pid_in_group = GROUP_M * num_pid_n
+    group_id = pid // num_pid_in_group
+    first_pid_m = group_id * GROUP_M
+    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)
+    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)
+    pid_n = (pid % num_pid_in_group) // group_size_m
+
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    offs_am = offs_m % M
+    offs_bn = offs_n % N
+    offs_k = tl.arange(0, BLOCK_K)
+    a_ptrs = a_ptr + offs_am[:, None].to(tl.int64) * stride_am + offs_k[None, :] * stride_ak
+    b_ptrs = b_ptr + offs_bn[None, :].to(tl.int64) * stride_bn + offs_k[:, None] * stride_bk
+
+    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.int32)
+    for k in range(0, tl.cdiv(K, BLOCK_K)):
+        if EVEN_K:
+            a = tl.load(a_ptrs)
+            b = tl.load(b_ptrs)
+        else:
+            k_left = K - k * BLOCK_K
+            a = tl.load(a_ptrs, mask=offs_k[None, :] < k_left, other=0)
+            b = tl.load(b_ptrs, mask=offs_k[:, None] < k_left, other=0)
+        acc = tl.dot(a, b, acc, out_dtype=tl.int32)
+        a_ptrs += BLOCK_K * stride_ak
+        b_ptrs += BLOCK_K * stride_bk
+
+    a_zero = tl.load(az_ptr + offs_am)
+    b_rowsum = tl.load(brs_ptr + offs_bn)
+    acc = acc - a_zero[:, None] * b_rowsum[None, :]
+    a_scale = tl.load(as_ptr + offs_am).to(tl.float32)
+    b_scale = tl.load(bs_ptr + offs_bn).to(tl.float32)
+    out = acc.to(tl.float32) * a_scale[:, None] * b_scale[None, :]
+    c_ptrs = c_ptr + offs_m[:, None].to(tl.int64) * stride_cm + offs_n[None, :] * stride_cn
+    c_mask = (offs_m[:, None] < M) & (offs_n[None, :] < N)
+    tl.store(c_ptrs, out.to(c_ptr.dtype.element_ty), mask=c_mask)
+
+
+# ----------------------------------------------------------------------------- host wrappers
+
+def _inv_qmax(n_bits):
+    """fp32(1) / fp32(qmax) as a Python float (exactly representable in fp32)."""
+    one = torch.tensor(1.0, dtype=torch.float32)
+    return float(one / torch.tensor(float(2 ** n_bits - 1), dtype=torch.float32))
+
+
+def asym_codes(x2d: torch.Tensor, n_bits: int, clip: float | None):
+    """Per-token asym quant of x2d [M, K] (fp32/fp16, unit stride) -> (int8 codes in [0, qmax], fp32 scale [M],
+    int32 zero [M]); identical numbers to runtime.fake_quant_per_token."""
+    m, k = x2d.shape
+    if x2d.stride(-1) != 1:
+        x2d = x2d.contiguous()
+    q = torch.empty((m, k), dtype=torch.int8, device=x2d.device)
+    s = torch.empty((m,), dtype=torch.float32, device=x2d.device)
+    z = torch.empty((m,), dtype=torch.int32, device=x2d.device)
+    if m:
+        args = (x2d, q, s, z, int(k), int(x2d.stride(0)), int(q.stride(0)), float(clip or 1.0), _inv_qmax(n_bits))
+        meta = dict(HAS_CLIP=bool(clip), QMAX=float(2 ** n_bits - 1))
+        block = triton.next_power_of_2(int(k))
+        if block <= 4096:
+            _asym_codes_kernel[(int(m),)](*args, **meta, BLOCK_K=block, num_warps=8 if block >= 2048 else 4)
+        else:
+            _asym_codes_looped_kernel[(int(m),)](*args, **meta, BLOCK_K=4096, num_warps=8)
+    return q, s, z
+
+
+def asym_fake_quant_rows(x: torch.Tensor, n_bits: int, clip: float | None, out_dtype=torch.float16):
+    """runtime.fake_quant_per_token(x, n_bits, clip).to(out_dtype) for rows of the last dim (power of 2)."""
+    d = x.shape[-1]
+    if d & (d - 1) or d > 1024:
+        raise ValueError(f"row length {d} must be a power of two <= 1024")
+    src = x if x.is_contiguous() else x.contiguous()
+    y = torch.empty(src.shape, dtype=out_dtype, device=src.device)
+    n_rows = src.numel() // d
+    if n_rows:
+        rows = max(1, 4096 // d)
+        _asym_fake_quant_rows_kernel[(triton.cdiv(n_rows, rows),)](
+            src, y, int(n_rows), float(clip or 1.0), _inv_qmax(n_bits), HAS_CLIP=bool(clip), QMAX=float(2 ** n_bits - 1),
+            D=int(d), ROWS=rows, num_warps=4)
+    return y
+
+
+def permute_cols(x2d: torch.Tensor, perm: torch.Tensor) -> torch.Tensor:
+    """x2d.index_select(-1, perm) (exact data movement) at copy bandwidth for rows up to 16384 values."""
+    m, k = x2d.shape
+    block = triton.next_power_of_2(int(k))
+    if block > 16384 or x2d.stride(-1) != 1 or not x2d.is_cuda:
+        return x2d.index_select(-1, perm)
+    y = torch.empty_like(x2d, memory_format=torch.contiguous_format)
+    if m:
+        _gather_cols_kernel[(int(m),)](x2d, perm, y, int(k), int(x2d.stride(0)), int(y.stride(0)), BLOCK=block,
+                                       num_warps=8 if block <= 4096 else 16)
+    return y
+
+
+def w4a4_azp_matmul(q, a_scale, a_zero, weight, weight_scale, weight_rowsum, out_dtype, config=None):
+    """uint4-in-int8 activation codes [M, K] x centred int8 weight codes [N, K] -> out_dtype [M, N]."""
+    m, k = q.shape
+    n = weight.shape[0]
+    out = torch.empty((m, n), dtype=out_dtype, device=q.device)
+    if m == 0:
+        return out
+    block_m, block_n, block_k, group_m, warps, stages = config or triton_w8a8._gemm_config(m, n, k)
+    grid = (triton.cdiv(int(m), block_m) * triton.cdiv(int(n), block_n),)
+    _w4a4_azp_gemm_kernel[grid](
+        q, weight, out, a_scale, a_zero, weight_scale, weight_rowsum,
+        int(m), int(n), int(k),
+        int(q.stride(0)), int(q.stride(1)), int(weight.stride(0)), int(weight.stride(1)),
+        int(out.stride(0)), int(out.stride(1)),
+        EVEN_K=(int(k) % block_k == 0),
+        BLOCK_M=block_m, BLOCK_N=block_n, BLOCK_K=block_k, GROUP_M=group_m,
+        num_warps=warps, num_stages=stages,
+    )
+    return out
