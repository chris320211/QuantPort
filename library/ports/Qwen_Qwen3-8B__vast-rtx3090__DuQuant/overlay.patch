index 0000000..c6e192b
--- /dev/null
+++ b/duquant_port/int8_runtime.py
@@ -0,0 +1,567 @@
+"""DuQuant integer runtime, format ``duquant_w4a4_int8_storage``: convert, load, run.
+
+Same quantization as the fake-quant runtime (``runtime.py``), run on integers:
+
+* weights: every decoder projection stores its W4 asymmetric codes CENTRED on the integer zero point,
+  ``weight = q_w - z_w`` (int8, [out, in], in [-15, 15]), plus an fp32 per-output-channel
+  ``weight_scale`` [out]. ``convert_artifact`` recovers them from the verified fake-quant checkpoint
+  (fp16 weights fp16(s * (q - z))) and checks that EVERY code reproduces its fp16 weight bit for bit,
+  fp16(fp32(scale) * code) == weight. fp32 scales: an fp16 scale cannot reproduce all codes exactly.
+* activations, per linear input and in the runtime's order: / Lambda (o_proj, GQA online smooth) ->
+  R1 -> permutation -> R2 (the runtime's own fp32 ``block_transform``: one [M*K/128, 128] @ [128, 128]
+  GEMM per rotation, an index_select for the permutation), then one Triton kernel for the per-token
+  asymmetric A4 quantizer (lac) that emits uint4 codes + fp32 scale + int32 zero, bit-identical to
+  ``fake_quant_per_token``. q/k/v share one transform and one GEMM (fused [q; k; v] weight), gate/up
+  share one transform and one GEMM (fused [gate; up]).
+* GEMM: int8 x int8 -> int32 Triton tensor-core kernel (the shared ``w8a8_int8`` kernel's tiling, copied
+  in ``triton_w8a8.py``) with an exact zero-point epilogue
+  ``(acc - z_x[m] * rowsum(c_w)[n]) * s_x[m] * s_w[n]`` (see ``kernels.py``).
+* attention: q_norm/k_norm before RoPE, 128-Hadamard + per-(token, head) asym A4 (lac) on Q and K (K
+  before ``Cache.update``), V per-(token, head) asym A4 after the cache concat, exactly as the runtime;
+  then ``scaled_dot_product_attention`` (flash when unmasked): ``is_causal`` only when q_len == kv_len,
+  decode (q_len == 1) without a mask, any other offset or a padding mask uses an explicit additive mask.
+* embeddings, lm_head, residual norms, q_norm/k_norm stay fp16.
+
+``load_int8_model`` builds the model on the meta device, swaps in the integer modules, allocates on the
+GPU and copies the saved tensors in, so no fp16 copy of the projections is ever built.
+"""
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import sys
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+from . import kernels, runtime
+
+FORMAT = "duquant_w4a4_int8_storage"
+SOURCE_FORMAT = "duquant_fakequant"
+SHARD_BYTES = 4 * 1024 ** 3
+COPY_FILES = ("config.json", "generation_config.json", "tokenizer.json", "tokenizer_config.json",
+              "special_tokens_map.json", "added_tokens.json", "vocab.json", "merges.txt", "tokenizer.model",
+              "chat_template.jinja", runtime.RUNTIME_FILE)
+
+
+# ----------------------------------------------------------------------------- config
+
+def read_config(model_path):
+    with open(os.path.join(model_path, runtime.QCONFIG_FILE)) as handle:
+        return json.load(handle)
+
+
+def is_int8_artifact(model_path) -> bool:
+    path = os.path.join(model_path, runtime.QCONFIG_FILE)
+    return os.path.exists(path) and read_config(model_path).get("format") == FORMAT
+
+
+def check_supported(qcfg):
+    """The integer path implements the DuQuant W4A4 setting of the fake-quant runtime exactly."""
+    want = {"quant_method": "duquant", "w_bits": 4, "a_bits": 4, "weight_quant": "per_channel",
+            "act_quant": "per_token", "w_sym": False, "a_sym": False, "online_transforms": True}
+    bad = {k: qcfg.get(k) for k, v in want.items() if qcfg.get(k) != v}
+    if int(qcfg.get("qk_bits", 4)) > 8 or int(qcfg.get("v_bits", 4)) > 8:
+        bad["kv_bits"] = (qcfg.get("qk_bits"), qcfg.get("v_bits"))
+    if bad:
+        raise ValueError(f"{FORMAT} needs DuQuant W4 per-channel asym x A4 per-token asym; artifact differs: {bad}")
+
+
+def kernel_quant_config(source_qcfg):
+    """quantization_config.json keys for the integer artifact (what `kernels.py match` reads)."""
+    qcfg = {k: v for k, v in source_qcfg.items() if k not in ("format", "attn_implementation", "publish_exclude",
+                                                               "weights_basis")}
+    qcfg.update({
+        "format": FORMAT,
+        "quant_method": "duquant",
+        "w_bits": 4,
+        "a_bits": 4,
+        "weight_quant": "per_channel",
+        "act_quant": "per_token",
+        "w_sym": False,
+        "a_sym": False,
+        "online_transforms": True,
+        "zero_point": "integer (round(-xmin / scale)); weights stored centred, activations corrected in the "
+                      "GEMM epilogue",
+        "weight_storage": "int8 centred codes q - z in [-15, 15] [out, in] + fp32 per-channel weight_scale [out]",
+        "weights_basis": "transformed (codes of Q(W*Lambda*R1*P*R2)); activations transformed online",
+        "kernels": "Triton int8 GEMM (shared w8a8_int8 tiling) + exact zero-point epilogue; Triton per-token "
+                   "asym A4 codes; Triton per-(token, head) asym fake quant for Q/K/V; SDPA (flash) attention",
+        "attn_implementation": "sdpa",
+        "real_quant": True,
+        "runtime_module": "duquant_port.int8_runtime",
+        "publish_exclude": [],
+    })
+    return qcfg
+
+
+# ----------------------------------------------------------------------------- conversion
+
+def _exact_scale(w16, codes):
+    """fp32 per-row scale s with fp16(fp32(s) * code) == w for every element, from the intersection of the
+    per-element fp16 rounding intervals (fp64 bounds). Returns (scale fp32 [N], ok bool [N])."""
+    w64 = w16.double()
+    bits = w16.view(torch.int16)
+    # fp16 neighbours of every value (bit +- 1 moves away from / towards zero by sign)
+    up = (bits + torch.where(bits >= 0, 1, -1).to(torch.int16)).view(torch.float16).double()
+    dn = (bits - torch.where(bits >= 0, 1, -1).to(torch.int16)).view(torch.float16).double()
+    zero_bits = bits == 0
+    dn = torch.where(zero_bits, torch.zeros_like(dn), dn)
+    a, b = (w64 + dn) / 2, (w64 + up) / 2  # rounding interval of w (|a| < |w| < |b|)
+    lo, hi = torch.minimum(a, b), torch.maximum(a, b)
+    k = codes.double()
+    nz = codes != 0
+    safe_k = torch.where(nz, k, torch.ones_like(k))
+    c1, c2 = lo / safe_k, hi / safe_k
+    s_lo = torch.where(nz, torch.minimum(c1, c2), torch.full_like(c1, -float("inf"))).amax(1)
+    s_hi = torch.where(nz, torch.maximum(c1, c2), torch.full_like(c1, float("inf"))).amin(1)
+    s = ((s_lo + s_hi) / 2)
+    s = torch.where(torch.isfinite(s), s, torch.full_like(s, runtime.CLIPMIN)).float()
+    back = (s[:, None] * codes.float()).to(torch.float16).view(torch.int16)
+    ok = (back == bits).all(1)
+    return s, ok
+
+
+@torch.no_grad()
+def pack_weight(weight: torch.Tensor, n_bits: int = 4):
+    """fp16 fake-quant weight [N, K] on a per-row asym grid -> (int8 centred codes, fp32 scale [N]).
+
+    Recovers code = q - z per row (the row's span is qmax steps when both clip ends are hit, which swc
+    clipping makes the rule; narrower rows are retried with spans qmax-1 .. 1) and an fp32 scale; raises
+    unless every code reproduces its fp16 weight bit for bit."""
+    qmax = 2 ** n_bits - 1
+    w16 = weight.to(torch.float16).contiguous()
+    w = w16.float()
+    wmax, wmin = w.amax(1), w.amin(1)
+    codes = torch.zeros(w.shape, dtype=torch.int16, device=w.device)
+    scale = torch.zeros(w.shape[0], dtype=torch.float32, device=w.device)
+    todo = torch.ones(w.shape[0], dtype=torch.bool, device=w.device)
+    for span in range(qmax, 0, -1):
+        rows = todo.nonzero().flatten()
+        if rows.numel() == 0:
+            break
+        s0 = ((wmax[rows] - wmin[rows]) / span).clamp(min=runtime.CLIPMIN)
+        k = torch.round(w[rows] / s0[:, None])
+        fits = (k.amax(1) - k.amin(1)) <= qmax
+        s, ok = _exact_scale(w16[rows], k.to(torch.int16))
+        ok &= fits
+        good = rows[ok]
+        codes[good] = k[ok].to(torch.int16)
+        scale[good] = s[ok]
+        todo[good] = False
+    flat_zero = todo & (wmax == 0) & (wmin == 0)  # all-zero row: any scale
+    scale[flat_zero] = runtime.CLIPMIN
+    todo &= ~flat_zero
+    if todo.any():
+        raise RuntimeError(f"{int(todo.sum())} of {w.shape[0]} rows are not on a {n_bits}-bit asym grid")
+    if codes.abs().max() > 127:
+        raise RuntimeError("centred codes exceed int8")
+    back = (scale[:, None] * codes.float()).to(torch.float16).view(torch.int16)
+    bad = int((back != w16.view(torch.int16)).sum())
+    if bad:
+        raise RuntimeError(f"{bad} of {w16.numel()} weights are not reproduced bit for bit by their int codes")
+    return codes.to(torch.int8), scale
+
+
+def _weight_files(model_path):
+    index = os.path.join(model_path, "model.safetensors.index.json")
+    if os.path.exists(index):
+        with open(index) as handle:
+            return sorted(set(json.load(handle)["weight_map"].values()))
+    return ["model.safetensors"]
+
+
+def _decoder_linear(key):
+    """'model.layers.3.self_attn.q_proj.weight' -> 'model.layers.3.self_attn.q_proj' for the 7 projections."""
+    if not key.endswith(".weight") or ".layers." not in key:
+        return None
+    prefix = key[: -len(".weight")]
+    if any(prefix.endswith("." + name) for name in runtime.LAYER_LINEARS):
+        return prefix
+    return None
+
+
+@torch.no_grad()
+def convert_artifact(src, dst, device="cuda", log=print):
+    """Fake-quant DuQuant artifact at ``src`` -> integer ``duquant_w4a4_int8_storage`` artifact at ``dst``."""
+    from safetensors import safe_open
+    from safetensors.torch import save_file
+
+    if os.path.abspath(src) == os.path.abspath(dst):
+        raise ValueError("convert into a new directory, not in place")
+    qcfg = read_config(src)
+    if qcfg.get("format") != SOURCE_FORMAT:
+        raise ValueError(f"{src} is not a {SOURCE_FORMAT} artifact (format={qcfg.get('format')})")
+    check_supported(qcfg)
+    os.makedirs(dst, exist_ok=True)
+    n_bits = int(qcfg["w_bits"])
+    out, stats = {}, {"projections": 0, "codes": 0, "max_abs_code": 0, "rows": 0}
+    for name in _weight_files(src):
+        with safe_open(os.path.join(src, name), framework="pt") as handle:
+            for key in handle.keys():
+                tensor = handle.get_tensor(key)
+                proj = _decoder_linear(key)
+                if proj is None:
+                    out[key] = tensor.contiguous()
+                    continue
+                codes, scale = pack_weight(tensor.to(device), n_bits)
+                out[proj + ".weight"] = codes.cpu()
+                out[proj + ".weight_scale"] = scale.cpu()
+                stats["projections"] += 1
+                stats["codes"] += codes.numel()
+                stats["rows"] += codes.shape[0]
+                stats["max_abs_code"] = max(stats["max_abs_code"], int(codes.abs().max()))
+    if stats["projections"] != 7 * int(qcfg["num_layers"]):
+        raise RuntimeError(f"packed {stats['projections']} projections, expected {7 * int(qcfg['num_layers'])}")
+    shards, current, size = [], {}, 0
+    for key in sorted(out):
+        nbytes = out[key].numel() * out[key].element_size()
+        if current and size + nbytes > SHARD_BYTES:
+            shards.append(current)
+            current, size = {}, 0
+        current[key] = out[key]
+        size += nbytes
+    shards.append(current)
+    weight_map, total = {}, 0
+    for i, shard in enumerate(shards):
+        fname = f"model-{i + 1:05d}-of-{len(shards):05d}.safetensors"
+        save_file(shard, os.path.join(dst, fname), metadata={"format": "pt", "quant_format": FORMAT})
+        for key, tensor in shard.items():
+            weight_map[key] = fname
+            total += tensor.numel() * tensor.element_size()
+    with open(os.path.join(dst, "model.safetensors.index.json"), "w") as handle:
+        json.dump({"metadata": {"total_size": total, "quant_format": FORMAT}, "weight_map": weight_map}, handle,
+                  indent=2)
+    for fname in COPY_FILES:
+        path = os.path.join(src, fname)
+        if os.path.exists(path):
+            shutil.copy2(path, os.path.join(dst, fname))
+    new_cfg = kernel_quant_config(qcfg)
+    new_cfg["converted_from_format"] = SOURCE_FORMAT
+    with open(os.path.join(dst, runtime.QCONFIG_FILE), "w") as handle:
+        json.dump(new_cfg, handle, indent=2)
+    stats.update(shards=len(shards), tensor_bytes=total, bit_exact=True)
+    log(f"converted {stats['projections']} projections ({stats['codes']} codes, all bit-exact) into "
+        f"{len(shards)} shard(s), {total / 1e9:.2f} GB of tensors")
+    return stats
+
+
+# ----------------------------------------------------------------------------- modules
+
+class DuQuantInt8Linear(nn.Module):
+    """Decoder projection: int8 centred W4 codes + fp32 scale; online DuQuant transform + A4 codes + int8 GEMM."""
+
+    def __init__(self, in_features, out_features, bias=False, *, a_bits=4, lac=None, block_size=128,
+                 dtype=torch.float16):
+        super().__init__()
+        if in_features % block_size:
+            raise ValueError(f"in_features {in_features} not divisible by block_size {block_size}")
+        self.in_features, self.out_features = int(in_features), int(out_features)
+        self.du_a_bits, self.du_lac, self.du_block = int(a_bits), lac, int(block_size)
+        self.register_buffer("weight", torch.empty((out_features, in_features), dtype=torch.int8))
+        self.register_buffer("weight_scale", torch.empty((out_features,), dtype=torch.float32))
+        if bias:
+            self.register_buffer("bias", torch.empty(out_features, dtype=dtype))
+        else:
+            self.bias = None
+        self.register_buffer("weight_rowsum", None, persistent=False)
+        self.register_buffer("du_R", None, persistent=False)
+        self.register_buffer("du_perm", None, persistent=False)
+        self.register_buffer("du_smooth", None, persistent=False)
+        self.gemm_config = None
+
+    def finalize(self):
+        self.weight_rowsum = self.weight.sum(dim=1, dtype=torch.int32)
+
+    def set_transform(self, R, perm, smooth):
+        dev = self.weight.device
+        self.du_R = R.detach().float().to(dev)
+        self.du_perm = None if perm is None else perm.detach().long().to(dev)
+        self.du_smooth = None if smooth is None else smooth.detach().float().reshape(-1).to(dev)
+
+    def transform_input(self, x):
+        """fp32 / Lambda -> R1 -> P -> R2 on [M, K], the numbers of runtime.DuQuantLinear.du_quant_input:
+        the same fp32 ops and GEMM shapes ([M*K/bs, bs] @ [bs, bs] per rotation); the permutation (pure data
+        movement, so exact by construction) is a Triton row gather instead of index_select."""
+        k = self.in_features
+        if x.dtype == torch.float32:
+            xf = x.reshape(-1, k)
+            if self.du_smooth is not None:
+                xf = xf / self.du_smooth
+        else:
+            if x.is_contiguous():
+                xf = x.reshape(-1, k).float()
+            else:  # e.g. the attention output [b, L, h, d] seen through a transpose: one convert+copy pass
+                xf = torch.empty(x.shape, dtype=torch.float32, device=x.device)
+                xf.copy_(x)
+                xf = xf.view(-1, k)
+            if self.du_smooth is not None:
+                xf.div_(self.du_smooth)  # fresh fp32 tensor: same IEEE division as xf / smooth
+        R, perm, bs = self.du_R, self.du_perm, self.du_block
+        n_perm = 0 if perm is None else perm.shape[0]
+        for i in range(n_perm):
+            xf = (xf.reshape(-1, bs) @ R[i]).reshape(-1, k)
+            xf = kernels.permute_cols(xf, perm[i])
+        return (xf.reshape(-1, bs) @ R[-1]).reshape(-1, k)
+
+    def quant_input(self, x):
+        """-> (uint4 codes int8 [M, K], fp32 scale [M], int32 zero [M])."""
+        return kernels.asym_codes(self.transform_input(x), self.du_a_bits, self.du_lac)
+
+    def dequantized_weight(self, dtype=torch.float16):
+        return (self.weight_scale[:, None] * self.weight.float()).to(dtype)
+
+    def forward(self, x):
+        return self.forward_rows(x, x.shape[:-1])
+
+    def forward_rows(self, x, lead):
+        """x holds prod(lead) rows of in_features values in any (possibly strided) shape, e.g. the attention
+        output [b, L, h, d] seen through a transpose."""
+        q, s, z = self.quant_input(x)
+        out = kernels.w4a4_azp_matmul(q, s, z, self.weight, self.weight_scale, self.weight_rowsum, x.dtype,
+                                      self.gemm_config)
+        if self.bias is not None:
+            out = out + self.bias
+        return out.view(*lead, self.out_features)
+
+    def extra_repr(self):
+        return (f"in={self.in_features}, out={self.out_features}, a_bits={self.du_a_bits}, lac={self.du_lac}, "
+                f"format={FORMAT}")
+
+
+class _Fused:
+    """[a; b; ...] weights of linears that share one input transform: one GEMM, module weights are views."""
+
+    def __init__(self, linears):
+        self.linears = linears
+        self.splits = [lin.out_features for lin in linears]
+        self.weight = torch.cat([lin.weight for lin in linears], 0).contiguous()
+        self.scale = torch.cat([lin.weight_scale for lin in linears], 0).contiguous()
+        self.rowsum = self.weight.sum(dim=1, dtype=torch.int32)
+        biases = [lin.bias for lin in linears]
+        self.bias = None
+        if any(b is not None for b in biases):
+            self.bias = torch.cat([b if b is not None else torch.zeros(lin.out_features, dtype=torch.float16,
+                                                                       device=lin.weight.device)
+                                   for b, lin in zip(biases, linears)])
+        start = 0
+        for lin, n in zip(linears, self.splits):  # re-point the modules at the fused storage (no extra copy)
+            lin.weight = self.weight[start:start + n]
+            lin.weight_scale = self.scale[start:start + n]
+            lin.weight_rowsum = self.rowsum[start:start + n]
+            start += n
+        self.config = None
+
+    def __call__(self, codes, out_dtype):
+        q, s, z = codes
+        out = kernels.w4a4_azp_matmul(q, s, z, self.weight, self.scale, self.rowsum, out_dtype, self.config)
+        if self.bias is not None:
+            out = out + self.bias
+        return out.split(self.splits, dim=-1)
+
+
+def _qk_quant(self, x):
+    """runtime._qk_quant: 128-Hadamard over head_dim (fp32, same op) then per-(token, head) asym fake quant."""
+    shape = x.shape
+    xf = x.float().reshape(-1, self.du_H.shape[0]) @ self.du_H
+    return kernels.asym_fake_quant_rows(xf, self.du_qk_bits, self.du_qk_lac, x.dtype).reshape(shape)
+
+
+def _sdpa(query, key, value, attention_mask, scaling, cache_position):
+    bsz, _, q_len, _ = query.shape
+    kv_len = key.shape[-2]
+    gqa = query.shape[1] != key.shape[1]
+    if attention_mask is not None and attention_mask.dim() == 4:
+        mask = attention_mask[:, :, :, :kv_len]
+        return F.scaled_dot_product_attention(query, key, value, attn_mask=mask, scale=scaling, enable_gqa=gqa)
+    if attention_mask is None and q_len == kv_len:
+        return F.scaled_dot_product_attention(query, key, value, is_causal=q_len > 1, scale=scaling,
+                                              enable_gqa=gqa)
+    if attention_mask is None and q_len == 1:
+        return F.scaled_dot_product_attention(query, key, value, scale=scaling, enable_gqa=gqa)
+    # chunked prefill with a cache offset, or a 2-D padding mask: explicit additive causal mask (runtime D6)
+    mask = runtime._causal_mask(attention_mask, bsz, q_len, kv_len, cache_position, query.dtype, query.device)
+    return F.scaled_dot_product_attention(query, key, value, attn_mask=mask, scale=scaling, enable_gqa=gqa)
+
+
+def int8_attention_forward(self, hidden_states, position_embeddings=None, attention_mask=None,
+                           past_key_value=None, cache_position=None, **kwargs):
+    """runtime.du_attention_forward on integers. Q/K stay in [b, L, h, d] through q_norm/k_norm, RoPE, the
+    Hadamard and the quantizer (element-wise / per-row ops, so the same numbers as the [b, h, L, d] runtime
+    without its transpose copies) and are handed to SDPA as transposed views."""
+    hf = sys.modules[type(self).__mro__[1].__module__]
+    bsz, q_len, _ = hidden_states.shape
+    hidden_shape = (bsz, q_len, -1, self.head_dim)
+    codes = self.q_proj.quant_input(hidden_states)  # q/k/v share q_proj's transform
+    query, key, value = self._du_qkv(codes, hidden_states.dtype)
+    query = query.view(hidden_shape)
+    key = key.view(hidden_shape)
+    # own storage for V: the cache must not pin the whole fused qkv output
+    value = value.reshape(hidden_shape).transpose(1, 2).contiguous()
+    if getattr(self, "q_norm", None) is not None:
+        query = self.q_norm(query)
+    if getattr(self, "k_norm", None) is not None:
+        key = self.k_norm(key)
+    cos, sin = position_embeddings
+    query, key = hf.apply_rotary_pos_emb(query, key, cos, sin, unsqueeze_dim=2)
+    query = _qk_quant(self, query).transpose(1, 2)
+    key = _qk_quant(self, key).transpose(1, 2)  # K enters the cache Hadamard-rotated + quantized
+    if past_key_value is not None:
+        cache_kwargs = {"sin": sin, "cos": cos, "cache_position": cache_position}
+        key, value = past_key_value.update(key, value, self.layer_idx, cache_kwargs)
+    value = kernels.asym_fake_quant_rows(value, self.du_v_bits, None, value.dtype)  # V quantized after concat
+    out = _sdpa(query, key, value, attention_mask, self.scaling, cache_position)
+    return self.o_proj.forward_rows(out.transpose(1, 2), (bsz, q_len)), None
+
+
+def int8_mlp_forward(self, x):
+    codes = self.gate_proj.quant_input(x)  # gate/up share gate_proj's transform
+    gate, up = self._du_gate_up(codes, x.dtype)
+    h = self.act_fn(gate) * up
+    return self.down_proj(h.view(*x.shape[:-1], -1))
+
+
+_CLASS_CACHE: dict = {}
+
+
+def _swap_class(module, forward, tag):
+    base = type(module)
+    if getattr(base, "_duquant_int8", False):
+        return
+    key = (base, tag)
+    if key not in _CLASS_CACHE:
+        _CLASS_CACHE[key] = type(f"DuQuantInt8{base.__name__}", (base,), {"forward": forward, "_duquant_int8": True})
+    module.__class__ = _CLASS_CACHE[key]
+
+
+# ----------------------------------------------------------------------------- build + load
+
+def _build_skeleton(model_path, qcfg, dtype):
+    from transformers import AutoConfig
+    from transformers.models.auto.modeling_auto import MODEL_FOR_CAUSAL_LM_MAPPING
+
+    config = AutoConfig.from_pretrained(model_path, local_files_only=True)
+    bs = int(qcfg["block_size"])
+    # Resolve (import) the model class before entering the meta-device context: lazy imports under a
+    # TorchFunctionMode hit a circular torch._dynamo import.
+    model_cls = MODEL_FOR_CAUSAL_LM_MAPPING[type(config)]
+    with torch.device("meta"):
+        model = model_cls._from_config(config, torch_dtype=dtype, attn_implementation="sdpa")
+        layers, _ = runtime.decoder_layers(model)
+        for layer in layers:
+            for name in runtime.LAYER_LINEARS:
+                parent_name, child = name.rsplit(".", 1)
+                parent = layer.get_submodule(parent_name)
+                lin = getattr(parent, child)
+                setattr(parent, child, DuQuantInt8Linear(
+                    lin.in_features, lin.out_features, bias=lin.bias is not None, a_bits=qcfg["a_bits"],
+                    lac=qcfg.get("lac"), block_size=bs, dtype=dtype))
+    return model, config
+
+
+@torch.no_grad()
+def _load_tensors(model, model_path):
+    from safetensors import safe_open
+
+    state = dict(model.named_parameters())
+    state.update(dict(model.named_buffers()))
+    expected = set(model.state_dict().keys())
+    tied = bool(getattr(model.config, "tie_word_embeddings", False))
+    if tied:
+        expected.discard("lm_head.weight")
+    seen = set()
+    for name in _weight_files(model_path):
+        with safe_open(os.path.join(model_path, name), framework="pt") as handle:
+            for key in handle.keys():
+                if key not in expected:
+                    raise RuntimeError(f"unexpected tensor in {FORMAT} artifact: {key}")
+                tensor = handle.get_tensor(key)
+                target = state[key]
+                if tuple(tensor.shape) != tuple(target.shape):
+                    raise RuntimeError(f"{key}: saved {tuple(tensor.shape)} vs built {tuple(target.shape)}")
+                if target.dtype in (torch.int8, torch.float32) and tensor.dtype != target.dtype:
+                    raise RuntimeError(f"{key}: expected {target.dtype}, got {tensor.dtype}")
+                target.copy_(tensor)
+                seen.add(key)
+    missing = sorted(expected - seen)
+    if missing:
+        raise RuntimeError(f"{FORMAT} artifact is missing {len(missing)} tensors: {missing[:8]}")
+    if tied:
+        model.tie_weights()
+
+
+def install_int8_runtime(model, qcfg, tensors):
+    layers, prefix = runtime.decoder_layers(model)
+    if len(layers) != int(qcfg["num_layers"]):
+        raise ValueError(f"artifact has {qcfg['num_layers']} DuQuant layers, model has {len(layers)}")
+    bs = int(qcfg["block_size"])
+    for i, layer in enumerate(layers):
+        attn, mlp = layer.self_attn, layer.mlp
+        if attn.head_dim % bs:
+            raise ValueError(f"block_size {bs} must divide head_dim {attn.head_dim} for the Q/K Hadamard")
+        if getattr(attn, "sliding_window", None):
+            raise NotImplementedError("sliding-window attention is not supported by the DuQuant runtime")
+        for name in runtime.LAYER_LINEARS:
+            key = f"{prefix}.{i}.{name}"
+            lin = layer.get_submodule(name)
+            lin.set_transform(tensors[f"{key}.du_R"], tensors.get(f"{key}.du_perm"), tensors.get(f"{key}.du_smooth"))
+            lin.finalize()
+        for lead, followers in (("self_attn.q_proj", ("self_attn.k_proj", "self_attn.v_proj")),
+                                ("mlp.gate_proj", ("mlp.up_proj",))):
+            ref = layer.get_submodule(lead)
+            for name in followers:
+                other = layer.get_submodule(name)
+                same = torch.equal(ref.du_R, other.du_R) and (
+                    (ref.du_perm is None and other.du_perm is None) or torch.equal(ref.du_perm, other.du_perm))
+                if not same or other.du_smooth is not None:
+                    raise ValueError(f"layer {i}: {name} transform differs from {lead}")
+        attn._du_qkv = _Fused([attn.q_proj, attn.k_proj, attn.v_proj])
+        mlp._du_gate_up = _Fused([mlp.gate_proj, mlp.up_proj])
+        _swap_class(attn, int8_attention_forward, "attn")
+        _swap_class(mlp, int8_mlp_forward, "mlp")
+        attn.du_qk_bits = int(qcfg.get("qk_bits", qcfg["a_bits"]))
+        attn.du_qk_lac = qcfg.get("qk_lac", qcfg.get("lac"))
+        attn.du_v_bits = int(qcfg.get("v_bits", qcfg["a_bits"]))
+        attn.register_buffer("du_H", runtime.get_hadamard(bs).to(attn.q_proj.weight.device), persistent=False)
+    model.config.use_cache = True
+    return model
+
+
+def load_int8_model(model_path, device="cuda", dtype=torch.float16):
+    """Rebuild a ``duquant_w4a4_int8_storage`` artifact on the GPU (meta-device build, no fp16 projections)."""
+    from safetensors.torch import load_file
+    from transformers import AutoTokenizer
+
+    if not (str(device).startswith("cuda") and torch.cuda.is_available()):
+        raise RuntimeError(f"{FORMAT} needs CUDA (Triton int8 GEMM); got device={device}")
+    dtype = torch.float16  # the method is fp16 end to end
+    qcfg = read_config(model_path)
+    if qcfg.get("format") != FORMAT:
+        raise ValueError(f"{model_path} is not a {FORMAT} artifact")
+    check_supported(qcfg)
+    tokenizer = AutoTokenizer.from_pretrained(model_path)
+    model, config = _build_skeleton(model_path, qcfg, dtype)
+    model.to_empty(device=device)
+    _load_tensors(model, model_path)
+    for param in model.parameters():
+        param.requires_grad_(False)
+    inner = model.model
+    inner.rotary_emb = type(inner.rotary_emb)(config=config, device=device)  # inv_freq is non-persistent
+    tensors = load_file(os.path.join(model_path, qcfg.get("runtime_file", runtime.RUNTIME_FILE)), device=str(device))
+    install_int8_runtime(model, qcfg, tensors)
+    try:
+        from transformers import GenerationConfig
+
+        model.generation_config = GenerationConfig.from_pretrained(model_path, local_files_only=True)
+    except Exception:  # noqa: BLE001 - optional file
+        pass
+    model.eval()
+    model.quant_agent_runtime = {
+        "format": FORMAT,
+        "int8_linears": sum(isinstance(m, DuQuantInt8Linear) for m in model.modules()),
+        "attention": "sdpa (flash when unmasked)",
+        "qk_bits": qcfg.get("qk_bits"), "v_bits": qcfg.get("v_bits"), "lac": qcfg.get("lac"),
+    }
+    return model, tokenizer
