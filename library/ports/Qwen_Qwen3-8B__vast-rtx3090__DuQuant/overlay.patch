+++ b/duquant_port/runtime.py
@@ -0,0 +1,302 @@
+"""DuQuant inference runtime on stock transformers-4.51 decoder modules (fake-quant, online transforms).
+
+Every decoder linear becomes a `DuQuantLinear` (an `nn.Linear` subclass). Its `.weight` holds the frozen
+fake-quant weight Q(W . Lambda . G) in the TRANSFORMED basis (fp16, <= 2^w_bits values per row). Its input
+gets, online and in this order (method.md Invariants, "Activation transform order"):
+  / Lambda_online (o_proj under GQA only, D4) -> R1 -> zigzag permutation P -> R2 -> per-token asym quant (lac)
+which is `quantize/quantizer.py` init_duquant + per_token_dynamic_calibration + fake_quant, except that the
+permutation is applied with index_select on the LAST dim, so any batch/sequence shape works (D9).
+
+The attention keeps q_norm/k_norm before RoPE (D3), then applies the block_size Hadamard on head_dim and
+per-(token, head) asym quant (lac) to Q and K; K is quantized BEFORE the Cache.update, V is quantized per
+(token, head) AFTER it (repo int_llama_layer.py:132-168). Softmax output stays 16-bit. The causal mask is
+the model's 4-D eager mask, or is built here with the cache offset when the caller passes None/2-D (D6).
+"""
+from __future__ import annotations
+
+import json
+import math
+import os
+import sys
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+RUNTIME_FILE = "duquant_runtime.safetensors"
+QCONFIG_FILE = "quantization_config.json"
+CLIPMIN, CLIPMAX = 1e-5, 1e4  # quantize/const.py
+ATTN_LINEARS = ("q_proj", "k_proj", "v_proj", "o_proj")
+MLP_LINEARS = ("gate_proj", "up_proj", "down_proj")
+LAYER_LINEARS = tuple(f"self_attn.{n}" for n in ATTN_LINEARS) + tuple(f"mlp.{n}" for n in MLP_LINEARS)
+
+
+def get_hadamard(n: int) -> torch.Tensor:
+    """utils.get_hadamard: normalized Sylvester Hadamard (power-of-two n)."""
+    if n & (n - 1):
+        raise ValueError(f"Hadamard size must be a power of two, got {n}")
+    if n == 1:
+        return torch.ones(1, 1)
+    h = get_hadamard(n // 2)
+    return torch.cat([torch.cat([h, h], dim=1), torch.cat([h, -h], dim=1)], dim=0) / math.sqrt(2)
+
+
+def fake_quant_per_token(x: torch.Tensor, n_bits: int, clip: float | None = None) -> torch.Tensor:
+    """quantizer.py per_token_dynamic_calibration (asym, reduce over last dim, clip) + fake_quant, in fp32."""
+    xf = x.float()
+    if n_bits >= 16:
+        return xf
+    xmin = xf.amin(-1, keepdim=True)
+    xmax = xf.amax(-1, keepdim=True)
+    if clip:
+        xmin = xmin * clip
+        xmax = xmax * clip
+    qmax = 2 ** n_bits - 1
+    scale = ((xmax - xmin) / qmax).clamp(min=CLIPMIN, max=CLIPMAX)
+    zero = (-xmin / scale).clamp(min=-CLIPMAX, max=CLIPMAX).round()
+    q = (torch.round(xf / scale) + zero).clamp(0, qmax)
+    return (q - zero) * scale
+
+
+def block_transform(x: torch.Tensor, R: torch.Tensor, perm: torch.Tensor | None) -> torch.Tensor:
+    """quantizer.init_duquant (calibrated path): x.reshape(-1,bs)@R[i], permute, ..., @R[-1] on the last dim."""
+    shape = x.shape
+    channels = shape[-1]
+    bs = R.shape[-1]
+    x = x.reshape(-1, channels)
+    n_perm = 0 if perm is None else perm.shape[0]
+    for i in range(n_perm):
+        x = (x.reshape(-1, bs) @ R[i]).reshape(-1, channels)
+        x = x.index_select(-1, perm[i])
+    x = (x.reshape(-1, bs) @ R[-1]).reshape(-1, channels)
+    return x.reshape(shape)
+
+
+class DuQuantLinear(nn.Linear):
+    """nn.Linear holding Q(W.Lambda.G) whose input is transformed and fake-quantized online."""
+
+    def du_setup(self, *, a_bits: int, lac: float | None, block_size: int):
+        if self.in_features % block_size:
+            raise ValueError(f"in_features {self.in_features} not divisible by block_size {block_size}")
+        self.du_a_bits = int(a_bits)
+        self.du_lac = lac
+        self.du_block = int(block_size)
+        # Non-persistent: the saved checkpoint stays a plain Qwen3 state dict; transforms live in RUNTIME_FILE.
+        self.register_buffer("du_R", None, persistent=False)
+        self.register_buffer("du_smooth", None, persistent=False)
+        # Kept off the buffer list so dtype casts never touch it and it is not counted as int weight storage.
+        self.du_perm = None
+        self._du_perm_dev = None
+        self.du_calibrator = None
+
+    def du_set_transform(self, R, perm, smooth=None):
+        device = self.weight.device
+        self.du_R = R.detach().float().to(device)
+        self.du_perm = None if perm is None else perm.detach().long().cpu()
+        self._du_perm_dev = None
+        self.du_smooth = None if smooth is None else smooth.detach().float().reshape(-1).to(device)
+
+    def _perm_on(self, device):
+        if self.du_perm is None:
+            return None
+        cached = self._du_perm_dev
+        if cached is None or cached.device != device:
+            cached = self.du_perm.to(device)
+            self._du_perm_dev = cached
+        return cached
+
+    def du_quant_input(self, x: torch.Tensor) -> torch.Tensor:
+        xf = x.float()
+        if self.du_smooth is not None:
+            xf = xf / self.du_smooth.to(xf.device)  # GQA o_proj online division (quantizer.py:344-345)
+        if self.du_R is None:
+            if self.du_calibrator is None:
+                raise RuntimeError("DuQuantLinear has no transform; reload through the DuQuant adapter")
+            self.du_calibrator(self, xf)
+        xf = block_transform(xf, self.du_R.to(xf.device, torch.float32), self._perm_on(xf.device))
+        return fake_quant_per_token(xf, self.du_a_bits, self.du_lac).to(x.dtype)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return F.linear(self.du_quant_input(x), self.weight, self.bias)
+
+
+def _causal_mask(attention_mask, bsz, q_len, kv_len, cache_position, dtype, device):
+    """Additive (bsz,1,q,kv) mask. Uses the model's 4-D mask when given; else causal with cache offset (D6)."""
+    if attention_mask is not None and attention_mask.dim() == 4:
+        return attention_mask[:, :, :, :kv_len].to(device=device, dtype=dtype)
+    if cache_position is not None and cache_position.numel() == q_len:
+        q_pos = cache_position.to(device)
+    else:
+        q_pos = torch.arange(kv_len - q_len, kv_len, device=device)
+    k_pos = torch.arange(kv_len, device=device)
+    min_value = torch.finfo(dtype).min
+    mask = torch.zeros(q_len, kv_len, dtype=dtype, device=device)
+    mask = mask.masked_fill(k_pos[None, :] > q_pos[:, None], min_value)
+    mask = mask[None, None].expand(bsz, 1, q_len, kv_len)
+    if attention_mask is not None and attention_mask.dim() == 2:
+        pad = attention_mask[:, -kv_len:].to(device) == 0
+        mask = mask.masked_fill(pad[:, None, None, :], min_value)
+    return mask
+
+
+def _qk_quant(self, x: torch.Tensor) -> torch.Tensor:
+    """Hadamard over head_dim blocks then per-(token, head) asym quant (QuantMatMul quant_x1/x2, rotate=None)."""
+    shape = x.shape
+    H = self.du_H.to(x.device, torch.float32)
+    xf = (x.float().reshape(-1, H.shape[0]) @ H).reshape(shape)
+    return fake_quant_per_token(xf, self.du_qk_bits, self.du_qk_lac).to(x.dtype)
+
+
+def du_attention_forward(self, hidden_states, position_embeddings=None, attention_mask=None,
+                         past_key_value=None, cache_position=None, **kwargs):
+    hf = sys.modules[type(self).__mro__[1].__module__]  # the stock attention's modeling module
+    bsz, q_len, _ = hidden_states.shape
+    hidden_shape = (bsz, q_len, -1, self.head_dim)
+
+    # q/k/v share one transform computed on q_proj's input (int_llama_layer.py:119-124).
+    xq = self.q_proj.du_quant_input(hidden_states)
+    query = F.linear(xq, self.q_proj.weight, self.q_proj.bias).view(hidden_shape)
+    key = F.linear(xq, self.k_proj.weight, self.k_proj.bias).view(hidden_shape)
+    value = F.linear(xq, self.v_proj.weight, self.v_proj.bias).view(hidden_shape).transpose(1, 2)
+    if getattr(self, "q_norm", None) is not None:
+        query = self.q_norm(query)
+    if getattr(self, "k_norm", None) is not None:
+        key = self.k_norm(key)
+    query = query.transpose(1, 2)
+    key = key.transpose(1, 2)
+
+    cos, sin = position_embeddings
+    query, key = hf.apply_rotary_pos_emb(query, key, cos, sin)
+    query = _qk_quant(self, query)
+    key = _qk_quant(self, key)  # K enters the cache already rotated + quantized
+
+    if past_key_value is not None:
+        cache_kwargs = {"sin": sin, "cos": cos, "cache_position": cache_position}
+        key, value = past_key_value.update(key, value, self.layer_idx, cache_kwargs)
+    value = fake_quant_per_token(value, self.du_v_bits, None).to(value.dtype)  # V quantized after concat
+
+    key = hf.repeat_kv(key, self.num_key_value_groups)
+    value = hf.repeat_kv(value, self.num_key_value_groups)
+    attn = torch.matmul(query, key.transpose(2, 3)) * self.scaling
+    kv_len = key.shape[-2]
+    attn = attn + _causal_mask(attention_mask, bsz, q_len, kv_len, cache_position, attn.dtype, attn.device)
+    attn = torch.max(attn, torch.tensor(torch.finfo(attn.dtype).min, dtype=attn.dtype, device=attn.device))
+    attn = F.softmax(attn, dim=-1, dtype=torch.float32).to(query.dtype)  # P stays 16-bit
+    out = torch.matmul(attn, value).transpose(1, 2).reshape(bsz, q_len, -1).contiguous()
+    out = self.o_proj(out)
+    return out, (attn if kwargs.get("output_attentions") else None)
+
+
+def du_mlp_forward(self, x):
+    # gate/up share one transform computed on gate_proj's input (int_llama_layer.py:44-46).
+    xq = self.gate_proj.du_quant_input(x)
+    gate = F.linear(xq, self.gate_proj.weight, self.gate_proj.bias)
+    up = F.linear(xq, self.up_proj.weight, self.up_proj.bias)
+    return self.down_proj(self.act_fn(gate) * up)
+
+
+_CLASS_CACHE: dict = {}
+
+
+def _swap_class(module: nn.Module, forward, tag: str):
+    base = type(module)
+    if getattr(base, "_duquant_swapped", False):
+        return
+    key = (base, tag)
+    if key not in _CLASS_CACHE:
+        _CLASS_CACHE[key] = type(f"DuQuant{base.__name__}", (base,), {"forward": forward, "_duquant_swapped": True})
+    module.__class__ = _CLASS_CACHE[key]
+
+
+def decoder_layers(model):
+    inner = getattr(model, "model", None)
+    layers = getattr(inner, "layers", None)
+    if layers is None:
+        raise ValueError("expected a decoder-only model with model.model.layers")
+    return layers, "model.layers"
+
+
+def install_layer(layer: nn.Module, qcfg: dict):
+    """Swap one stock decoder layer's attention/MLP/linears to the DuQuant runtime classes (no weights touched)."""
+    attn, mlp = layer.self_attn, layer.mlp
+    bs = int(qcfg["block_size"])
+    if attn.head_dim % bs:
+        raise ValueError(f"block_size {bs} must divide head_dim {attn.head_dim} for the Q/K Hadamard")
+    if getattr(attn, "sliding_window", None):
+        raise NotImplementedError("sliding-window attention is not supported by the DuQuant runtime")
+    for name in LAYER_LINEARS:
+        lin = layer.get_submodule(name)
+        if type(lin) is nn.Linear:
+            lin.__class__ = DuQuantLinear
+        if not isinstance(lin, DuQuantLinear):
+            raise TypeError(f"{name} is {type(lin).__name__}, expected nn.Linear")
+        lin.du_setup(a_bits=qcfg["a_bits"], lac=qcfg.get("lac"), block_size=bs)
+    _swap_class(attn, du_attention_forward, "attn")
+    _swap_class(mlp, du_mlp_forward, "mlp")
+    attn.du_qk_bits = int(qcfg.get("qk_bits", qcfg["a_bits"]))
+    attn.du_qk_lac = qcfg.get("qk_lac", qcfg.get("lac"))
+    attn.du_v_bits = int(qcfg.get("v_bits", qcfg["a_bits"]))
+    attn.register_buffer("du_H", get_hadamard(bs).to(attn.q_proj.weight.device), persistent=False)
+
+
+def runtime_state(model) -> dict:
+    """Per-linear transform tensors for RUNTIME_FILE."""
+    layers, prefix = decoder_layers(model)
+    out = {}
+    for i, layer in enumerate(layers):
+        for name in LAYER_LINEARS:
+            lin = layer.get_submodule(name)
+            key = f"{prefix}.{i}.{name}"
+            out[f"{key}.du_R"] = lin.du_R.detach().float().cpu().contiguous()
+            if lin.du_perm is not None:
+                out[f"{key}.du_perm"] = lin.du_perm.detach().long().cpu().contiguous()
+            if lin.du_smooth is not None:
+                out[f"{key}.du_smooth"] = lin.du_smooth.detach().float().cpu().contiguous()
+    return out
+
+
+def install_runtime(model, qcfg: dict, tensors: dict):
+    layers, prefix = decoder_layers(model)
+    if len(layers) != int(qcfg["num_layers"]):
+        raise ValueError(f"artifact has {qcfg['num_layers']} DuQuant layers, model has {len(layers)}")
+    for i, layer in enumerate(layers):
+        install_layer(layer, qcfg)
+        for name in LAYER_LINEARS:
+            key = f"{prefix}.{i}.{name}"
+            lin = layer.get_submodule(name)
+            lin.du_set_transform(tensors[f"{key}.du_R"], tensors.get(f"{key}.du_perm"), tensors.get(f"{key}.du_smooth"))
+        # Shared transforms must really be shared, since the fused forwards apply q's / gate's only.
+        for lead, followers in (("self_attn.q_proj", ("self_attn.k_proj", "self_attn.v_proj")),
+                                ("mlp.gate_proj", ("mlp.up_proj",))):
+            ref = layer.get_submodule(lead)
+            for name in followers:
+                other = layer.get_submodule(name)
+                same = torch.equal(ref.du_R.cpu(), other.du_R.cpu()) and (
+                    (ref.du_perm is None and other.du_perm is None) or torch.equal(ref.du_perm, other.du_perm))
+                if not same or other.du_smooth is not None:
+                    raise ValueError(f"layer {i}: {name} transform differs from {lead}")
+    model.config.use_cache = True
+    return model
+
+
+def load_quantized(model_path, device="cuda", dtype=torch.float16):
+    """Rebuild a DuQuant fake-quant model from a saved OUTPUT_DIR (never from the Hub id)."""
+    from safetensors.torch import load_file
+    from transformers import AutoModelForCausalLM, AutoTokenizer
+
+    with open(os.path.join(model_path, QCONFIG_FILE)) as handle:
+        qcfg = json.load(handle)
+    if qcfg.get("quant_method") != "duquant":
+        raise ValueError(f"{model_path} is not a DuQuant artifact")
+    tokenizer = AutoTokenizer.from_pretrained(model_path)
+    kwargs = {"torch_dtype": dtype, "attn_implementation": "eager", "low_cpu_mem_usage": True}
+    on_cuda = str(device).startswith("cuda") and torch.cuda.is_available()
+    if on_cuda:
+        kwargs["device_map"] = {"": device}
+    model = AutoModelForCausalLM.from_pretrained(model_path, **kwargs)
+    if not on_cuda:
+        model.to("cpu")
+    tensors = load_file(os.path.join(model_path, qcfg.get("runtime_file", RUNTIME_FILE)))
+    install_runtime(model, qcfg, tensors)
+    model.eval()
+    return model, tokenizer
