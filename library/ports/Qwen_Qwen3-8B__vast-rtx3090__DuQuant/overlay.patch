+"""WikiText-2 train calibration windows, sampled exactly like datautils.get_wikitext2 (seeded random windows)."""
+from __future__ import annotations
+
+import glob
+import os
+import random
+
+import torch
+
+PARQUET_GLOB = ("datasets--Salesforce--wikitext/snapshots/*/wikitext-2-raw-v1/train-00000-of-00001.parquet")
+
+
+def wikitext2_train_texts(cache_dirs):
+    """Train rows in dataset order: a cached parquet when one exists, else datasets.load_dataset."""
+    for cache_dir in cache_dirs:
+        for path in sorted(glob.glob(os.path.join(str(cache_dir), PARQUET_GLOB))):
+            import pyarrow.parquet as pq
+
+            texts = pq.read_table(path, columns=["text"]).column("text").to_pylist()
+            print(f"wikitext2 train: {len(texts)} rows from {path}", flush=True)
+            return texts
+    from datasets import load_dataset
+
+    # Same rows as the repo's load_dataset('wikitext', 'wikitext-2-raw-v1', split='train').
+    texts = load_dataset("Salesforce/wikitext", "wikitext-2-raw-v1", split="train")["text"]
+    print(f"wikitext2 train: {len(texts)} rows from the Hub", flush=True)
+    return list(texts)
+
+
+def get_wikitext2_calib(tokenizer, nsamples, seqlen, seed, cache_dirs):
+    """datautils.get_wikitext2 trainloader: '\\n\\n'.join(train), random.seed(seed), randint windows."""
+    texts = wikitext2_train_texts(cache_dirs)
+    enc = tokenizer("\n\n".join(texts), return_tensors="pt").input_ids
+    random.seed(seed)
+    samples = []
+    for _ in range(nsamples):
+        i = random.randint(0, enc.shape[1] - seqlen - 1)
+        samples.append(enc[:, i:i + seqlen].clone())
+    return torch.cat(samples, dim=0)
