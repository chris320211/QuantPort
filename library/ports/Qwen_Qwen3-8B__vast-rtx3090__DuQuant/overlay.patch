+"""Reload a DuQuant (W4A4, 4-bit Q/K/V) artifact saved by duquant_port: integer or fake-quant format.
+
+Loads the SAVED directory only (never the Hub id); quantization_config.json `format` picks the path:
+
+* ``duquant_w4a4_int8_storage`` (kernel overlay): decoder projections hold int8 centred W4 codes + fp32
+  per-channel scales, built on the meta device and filled straight on the GPU (no fp16 projection copy).
+  Online / Lambda -> R1 -> P -> R2 (fp32, the runtime's ops) -> Triton per-token asym A4 codes -> Triton
+  int8 GEMM with an exact zero-point epilogue; q/k/v and gate/up each share one transform and one GEMM.
+  q_norm/k_norm -> RoPE -> 128-Hadamard + per-(token, head) A4 on Q/K (K before the cache), V A4 after the
+  cache concat, scaled_dot_product_attention (flash when unmasked). CUDA only.
+* ``duquant_fakequant`` (role_driver overlay): unchanged fp16 fake-quant runtime (duquant_port.runtime).
+
+Works for forward and generate (DynamicCache).
+"""
+import json
+import os
+import sys
+
+import torch
+
+QUANT_AGENT_ADAPTER_API = 1
+
+
+def load_model_and_tokenizer(model_path, model_id, dtype, device, trust_remote_code):
+    # The adapter sits at the method repo root next to the duquant_port package. Put it first so a caller's
+    # own quantize.py (the wrapper script) cannot shadow the repo's quantize package.
+    here = os.path.dirname(os.path.abspath(__file__))
+    sys.path[:] = [here] + [p for p in sys.path if os.path.abspath(p or ".") != here]
+
+    del model_id, trust_remote_code  # the artifact is self-describing; never touch the Hub id
+    del dtype  # the method is fp16 end to end (the repo forces fp16); a bf16 request still runs fp16
+    target = "cuda" if str(device).startswith("cuda") and torch.cuda.is_available() else "cpu"
+    with open(os.path.join(model_path, "quantization_config.json")) as handle:
+        fmt = json.load(handle).get("format")
+    if fmt == "duquant_w4a4_int8_storage":
+        from duquant_port.int8_runtime import load_int8_model
+
+        return load_int8_model(model_path, device=target, dtype=torch.float16)
+    from duquant_port.runtime import load_quantized
+
+    return load_quantized(model_path, device=target, dtype=torch.float16)
