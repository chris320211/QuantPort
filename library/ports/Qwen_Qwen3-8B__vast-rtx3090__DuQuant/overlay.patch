@@ -0,0 +1,351 @@
+"""DuQuant calibration on stock transformers-4.51 decoder layers (method.md Steps 1-13, run.sh recipe).
+
+Replaces the repo's family glue (D1: args.net switch, LMClass, QuantLlamaDecoderLayer, Catcher) with a
+role walk over `model.model.layers`; reuses the repo's generic pieces as-is:
+  - get_rot.py base rotation table (built in memory for block_size and seeded into utils.Rot, so no
+    cwd-relative Rot.pkl is needed) and utils.get_rot / exchange_row_col (D7);
+  - generate_act_scale_shift.get_act_scales semantics (per-input-channel max|x| of every linear, fp16 model,
+    same calibration windows), collected layer by layer on the ORIGINAL layer before it is touched (D7);
+  - duquant.py smoothing formula s = act^a / max|W_col|^(1-a) (clamp 1e-5, truncate_number 1e-2) and the
+    models/transformation.py fusers' algebra (norm / s, columns * s, up rows / s_down);
+  - quantize/quantizer.py UniformAffineQuantizer: online_duquant_cali (greedy rotation R1, zigzag P, R2) for
+    every activation quantizer and the weight quantizer (init_duquant + swc per-channel asym fake_quant).
+Layer inputs come from a forward pre-hook on layer 0 (hidden_states plus attention_mask, position_ids,
+position_embeddings, cache_position kwargs; D2). The rotation search runs on ONE averaged sequence that is
+propagated through the already-quantized layers (duquant.py:135,281). Statistics and transforms are
+computed in fp32 (D8); the stored model stays fp16.
+"""
+from __future__ import annotations
+
+import json
+import math
+import os
+import random
+import time
+
+import numpy as np
+import torch
+
+from . import runtime
+from .data import get_wikitext2_calib
+
+
+class _StopForward(Exception):
+    pass
+
+
+def base_rotation(n: int, device) -> torch.Tensor:
+    """get_rot.py: product of n-1 Givens rotations (cos 1/sqrt(i+2)), then swap row/col 0 and n-1."""
+    R = torch.eye(n, device=device)
+    for i in range(n - 1):
+        rot = torch.eye(n, device=device)
+        cos = 1 / np.sqrt(i + 2)
+        sin = np.sqrt(i + 1) / np.sqrt(i + 2)
+        rot[i, i] = rot[i + 1, i + 1] = cos
+        rot[i, i + 1] = -sin
+        rot[i + 1, i] = sin
+        R = torch.matmul(rot, R)
+    import utils as repo_utils
+
+    return repo_utils.exchange_row_col(R, 0, n - 1).cpu()
+
+
+def seed_everything(seed: int):
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    torch.cuda.manual_seed(seed)
+
+
+def _capture_layer0(model, layers, calib_ids, dev):
+    """Layer-0 inputs and decoder-layer kwargs via a pre-hook (replaces duquant.py Catcher)."""
+    inner = model.model
+    inner.embed_tokens.to(dev)
+    inner.rotary_emb.to(dev)
+    n, seqlen = calib_ids.shape
+    inps = torch.zeros((n, seqlen, model.config.hidden_size), dtype=torch.float16, device=dev)
+    captured = {}
+
+    def hook(module, args, kwargs):
+        hidden = args[0] if args else kwargs["hidden_states"]
+        inps[captured.setdefault("i", 0)] = hidden[0]
+        captured["i"] += 1
+        if "kwargs" not in captured:
+            captured["kwargs"] = {k: v for k, v in kwargs.items() if k != "hidden_states"}
+        raise _StopForward
+
+    handle = layers[0].register_forward_pre_hook(hook, with_kwargs=True)
+    try:
+        with torch.no_grad():
+            for j in range(n):
+                try:
+                    model(calib_ids[j:j + 1].to(dev), use_cache=False)
+                except _StopForward:
+                    pass
+    finally:
+        handle.remove()
+    inner.embed_tokens.cpu()
+    torch.cuda.empty_cache()
+    kw = dict(captured["kwargs"])
+    kw["use_cache"] = False
+    kw["past_key_value"] = None
+    kw["output_attentions"] = False
+    mask = kw.get("attention_mask")
+    if mask is None or mask.dim() != 4:
+        raise RuntimeError("expected a 4-D eager causal mask from the model (attn_implementation='eager', D6)")
+    return inps, kw
+
+
+def _fp_pass(layer, fp_inps, kw):
+    """Original fp16 layer over all samples: act max|x| per input channel of every linear (D7), in place."""
+    stats = {}
+
+    def make_hook(name):
+        def hook(module, args, output):
+            x = args[0].detach()
+            cur = x.reshape(-1, x.shape[-1]).abs().amax(dim=0).float()
+            stats[name] = cur if name not in stats else torch.maximum(stats[name], cur)
+        return hook
+
+    handles = [layer.get_submodule(n).register_forward_hook(make_hook(n)) for n in runtime.LAYER_LINEARS]
+    try:
+        for j in range(fp_inps.shape[0]):
+            fp_inps[j:j + 1] = layer(fp_inps[j:j + 1], **kw)[0]
+    finally:
+        for h in handles:
+            h.remove()
+    for name, value in stats.items():
+        if not torch.isfinite(value).all():
+            raise FloatingPointError(f"non-finite activation statistic at {name} (fp16 overflow, D8)")
+    if not torch.isfinite(fp_inps).all():
+        raise FloatingPointError("non-finite fp16 layer output during the statistics pass (D8)")
+    return stats
+
+
+def _smooth_scale(act, weight, alpha):
+    """duquant.py:209-213 + quantize/utils.py truncate_number(1e-2), in fp32."""
+    act = act.float().clamp(min=runtime.CLIPMIN)
+    wmax = weight.float().abs().amax(dim=0).clamp(min=runtime.CLIPMIN)
+    s = (act.pow(alpha) / wmax.pow(1 - alpha)).clamp(min=runtime.CLIPMIN)
+    small = s.abs() < 1e-2
+    return torch.where(small, s.sign() * 1e-2, s)
+
+
+def _div_bias(linear, scale):
+    """Output-side smoothing also scales a real bias (smooth_fc_fc_inplace: fc1.bias / s)."""
+    if linear.bias is not None:
+        linear.bias.data.copy_((linear.bias.float() / scale).to(linear.bias.dtype))
+
+
+def _smooth_layer(layer, stats, alpha):
+    """Fuse Lambda offline where elementwise producers allow; GQA o_proj gets the online division (D4)."""
+    attn, mlp = layer.self_attn, layer.mlp
+    w32 = {name: layer.get_submodule(name).weight.detach().float().clone() for name in runtime.LAYER_LINEARS}
+    s_qkv = _smooth_scale(stats["self_attn.q_proj"], w32["self_attn.q_proj"], alpha)
+    s_out = _smooth_scale(stats["self_attn.o_proj"], w32["self_attn.o_proj"], alpha)
+    s_fc1 = _smooth_scale(stats["mlp.up_proj"], w32["mlp.up_proj"], alpha)
+    s_down = _smooth_scale(stats["mlp.down_proj"], w32["mlp.down_proj"], alpha)
+
+    # smooth_ln_fcs_inplace: residual norm weight / s, readers' columns * s (shift = 0 for llama-like nets).
+    # Only the residual norms by name; q_norm/k_norm are never touched (D3).
+    norm = layer.input_layernorm
+    norm.weight.data.copy_((norm.weight.float() / s_qkv).to(norm.weight.dtype))
+    for name in ("self_attn.q_proj", "self_attn.k_proj", "self_attn.v_proj"):
+        w32[name].mul_(s_qkv.view(1, -1))
+    norm = layer.post_attention_layernorm
+    norm.weight.data.copy_((norm.weight.float() / s_fc1).to(norm.weight.dtype))
+    for name in ("mlp.gate_proj", "mlp.up_proj"):
+        w32[name].mul_(s_fc1.view(1, -1))
+    # smooth_fc_fc_inplace(up, down): valid because down's input is act(gate) * up elementwise.
+    w32["mlp.up_proj"].div_(s_down.view(-1, 1))
+    _div_bias(mlp.up_proj, s_down)
+    w32["mlp.down_proj"].mul_(s_down.view(1, -1))
+    # v -> o: offline fold only when each o input channel is exactly one v output channel (MHA).
+    gqa = attn.v_proj.out_features != attn.o_proj.in_features
+    online = None
+    if gqa:
+        w32["self_attn.o_proj"].mul_(s_out.view(1, -1))  # smooth_fc_inplace
+        online = s_out
+    else:
+        w32["self_attn.v_proj"].div_(s_out.view(-1, 1))
+        _div_bias(attn.v_proj, s_out)
+        w32["self_attn.o_proj"].mul_(s_out.view(1, -1))
+    scales = {"qkv": s_qkv, "out": s_out, "fc1": s_fc1, "down": s_down}
+    return w32, online, scales, gqa
+
+
+def _make_calibrator(group, w32, act_params, w_params, timings):
+    from quantize.quantizer import UniformAffineQuantizer
+
+    def calibrate(module, xf):
+        start = time.time()
+        aq = UniformAffineQuantizer(**act_params, rotate=True)
+        aq.online_duquant_cali(xf.reshape(-1, xf.shape[-1]))  # R1 -> zigzag P -> R2 on the activation
+        aq.init_duquant_params = torch.tensor(1)
+        R = aq.R.detach().float()
+        perm = aq.permutation_list.detach().long().cpu()
+        for name, lin in group:
+            W = w32.pop(name)
+            wq = UniformAffineQuantizer(**w_params, shape=W.shape, rotate=True)
+            wq.copy_duquant_params(aq)  # QuantLinear: weight quantizer copies its act quantizer's R/perm
+            Wq = wq(W)  # init_duquant(W) (same G on the input dim) + per-channel asym swc fake-quant
+            if not torch.isfinite(Wq).all():
+                raise FloatingPointError(f"non-finite fake-quant weight for {name}")
+            lin.weight.data.copy_(Wq.to(lin.weight.dtype))
+            lin.du_R = R.clone().to(lin.weight.device)
+            lin.du_perm = perm.clone()
+            lin._du_perm_dev = None
+            lin.du_calibrator = None
+        timings[group[0][0]] = round(time.time() - start, 2)
+
+    return calibrate
+
+
+def quantize(model_src, output_dir, settings, *, data_dirs, extra_config=None):
+    from transformers import AutoModelForCausalLM, AutoTokenizer
+
+    seed = int(settings["seed"])
+    seed_everything(seed)  # main.py:315-318
+    dev = torch.device("cuda")
+    bs = int(settings["block_size"])
+    tokenizer = AutoTokenizer.from_pretrained(model_src)
+    model = AutoModelForCausalLM.from_pretrained(
+        model_src, torch_dtype=torch.float16, attn_implementation="eager", low_cpu_mem_usage=True)
+    model.eval()
+    for p in model.parameters():
+        p.requires_grad_(False)
+    cfg = model.config
+    layers, _ = runtime.decoder_layers(model)
+    for dim_name in ("hidden_size", "intermediate_size"):
+        if getattr(cfg, dim_name) % bs:
+            raise ValueError(f"{dim_name} {getattr(cfg, dim_name)} not divisible by block_size {bs}")
+
+    # Step 1: base rotation table, seeded into the repo's utils.Rot cache (instead of ./Rot.pkl).
+    import utils as repo_utils
+
+    repo_utils.Rot[bs] = base_rotation(bs, dev)
+
+    calib = get_wikitext2_calib(tokenizer, int(settings["nsamples"]), int(settings["seqlen"]), seed, data_dirs)
+    print(f"calibration ids {tuple(calib.shape)}", flush=True)
+    inps, kw = _capture_layer0(model, layers, calib, dev)
+    fp_inps = inps
+    rotate_inps = inps.float().mean(dim=0).to(torch.float16)  # duquant.py:135 "mean embeddings"
+
+    act_params = {
+        "n_bits": settings["abits"], "per_channel_axes": [], "symmetric": False, "lac": settings["lac"],
+        "act_group_size": None, "dynamic_method": "per_token", "quant_method": "duquant",
+        "block_size": bs, "max_rotation_step": settings["max_rotation_step"],
+        "permutation_times": settings["permutation_times"],
+    }
+    w_params = {
+        "n_bits": settings["wbits"], "per_channel_axes": [0], "symmetric": False,
+        "dynamic_method": "per_channel", "group_size": None, "lwc": settings["lwc"], "swc": settings["swc"],
+        "quant_method": "duquant", "block_size": bs, "max_rotation_step": settings["max_rotation_step"],
+        "permutation_times": settings["permutation_times"],
+    }
+    qcfg = build_qconfig(settings, len(layers), extra_config)
+    log = []
+    total_start = time.time()
+    for i, layer in enumerate(layers):
+        start = time.time()
+        layer.to(dev)
+        with torch.no_grad():
+            fp_ref = layer(rotate_inps.unsqueeze(0), **kw)[0][0].float()
+            stats = _fp_pass(layer, fp_inps, kw)
+            w32, online, scales, gqa = _smooth_layer(layer, stats, float(settings["alpha"]))
+            runtime.install_layer(layer, qcfg)
+            timings = {}
+            attn, mlp = layer.self_attn, layer.mlp
+            groups = [
+                [("self_attn.q_proj", attn.q_proj), ("self_attn.k_proj", attn.k_proj),
+                 ("self_attn.v_proj", attn.v_proj)],
+                [("self_attn.o_proj", attn.o_proj)],
+                [("mlp.gate_proj", mlp.gate_proj), ("mlp.up_proj", mlp.up_proj)],
+                [("mlp.down_proj", mlp.down_proj)],
+            ]
+            for group in groups:
+                group[0][1].du_calibrator = _make_calibrator(group, w32, act_params, w_params, timings)
+            if online is not None:
+                attn.o_proj.du_smooth = online.to(dev)
+            out = layer(rotate_inps.unsqueeze(0), **kw)[0][0]
+            missing = [n for n in runtime.LAYER_LINEARS if layer.get_submodule(n).du_R is None]
+            if missing or w32:
+                raise RuntimeError(f"layer {i}: transforms not calibrated for {missing or sorted(w32)}")
+            if not torch.isfinite(out).all():
+                raise FloatingPointError(f"layer {i}: non-finite quantized output on the rotation input")
+            rel = ((out.float() - fp_ref).norm() / fp_ref.norm().clamp(min=1e-12)).item()
+            rotate_inps = out
+        layer.to("cpu")
+        torch.cuda.empty_cache()
+        entry = {
+            "layer": i, "seconds": round(time.time() - start, 1), "rotation_seconds": timings,
+            "rel_err_vs_fp_on_rotation_input": round(rel, 5), "gqa_online_o_smooth": gqa,
+            "act_max": {k.split(".")[-1]: round(v.max().item(), 3) for k, v in stats.items()},
+            "smooth_range": {k: [round(v.min().item(), 4), round(v.max().item(), 3)] for k, v in scales.items()},
+        }
+        log.append(entry)
+        print("layer " + json.dumps(entry), flush=True)
+    del inps, fp_inps
+    torch.cuda.empty_cache()
+    qcfg["quantize_seconds"] = round(time.time() - total_start, 1)
+    save(model, tokenizer, output_dir, qcfg, log)
+    return qcfg
+
+
+def build_qconfig(settings, num_layers, extra_config=None):
+    qcfg = {
+        "quant_method": "duquant",
+        "format": "duquant_fakequant",
+        "w_bits": settings["wbits"],
+        "a_bits": settings["abits"],
+        "weight_quant": "per_channel",
+        "w_sym": False,
+        "act_quant": "per_token",
+        "a_sym": False,
+        "online_transforms": True,
+        "qk_bits": settings["abits"],
+        "qk_lac": settings["lac"],
+        "qk_hadamard": True,
+        "v_bits": settings["abits"],
+        "v_lac": None,
+        "p_bits": 16,
+        "kv_cache": "K stored Hadamard-rotated + fake-quant; V stored fp16, fake-quant on read",
+        "block_size": settings["block_size"],
+        "max_rotation_step": settings["max_rotation_step"],
+        "permutation_times": settings["permutation_times"],
+        "alpha": settings["alpha"],
+        "smooth": True,
+        "lac": settings["lac"],
+        "swc": settings["swc"],
+        "lwc": settings["lwc"],
+        "epochs": settings["epochs"],
+        "weights_basis": "transformed (Q(W*Lambda*R1*P*R2)); activations transformed online",
+        "online_smooth_linears": ["self_attn.o_proj"],
+        "runtime_file": runtime.RUNTIME_FILE,
+        "runtime_module": "duquant_port.runtime",
+        "num_layers": num_layers,
+        "dtype": "float16",
+        "attn_implementation": "eager",
+        "calibration": {"dataset": "wikitext2", "nsamples": settings["nsamples"], "seqlen": settings["seqlen"],
+                        "seed": settings["seed"]},
+        "publish_exclude": ["duquant_calib_log.json"],
+    }
+    qcfg.update(extra_config or {})
+    return qcfg
+
+
+def save(model, tokenizer, output_dir, qcfg, log):
+    from safetensors.torch import save_file
+
+    os.makedirs(output_dir, exist_ok=True)
+    model.config.use_cache = True
+    model.config.torch_dtype = torch.float16
+    model.save_pretrained(output_dir, safe_serialization=True, max_shard_size="5GB")
+    tokenizer.save_pretrained(output_dir)
+    save_file(runtime.runtime_state(model), os.path.join(output_dir, runtime.RUNTIME_FILE),
+              metadata={"format": "pt"})
+    with open(os.path.join(output_dir, runtime.QCONFIG_FILE), "w") as handle:
+        json.dump(qcfg, handle, indent=2)
+    with open(os.path.join(output_dir, "duquant_calib_log.json"), "w") as handle:
+        json.dump(log, handle, indent=1)
+    print(f"saved DuQuant artifact to {output_dir}: {sorted(os.listdir(output_dir))}", flush=True)
